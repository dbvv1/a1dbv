# [一手] https://learn.chatgpt.com/docs/config-file/config-reference
# 2026-11-19 按官方更新 6.2 用法；先核 CLI ≥ 0.166.0 与账号权限。
# 以下 4 行模型/effort 可选：仅需要示例的深入审查配置时取消注释，按需合并。
# model = "gpt-6.2-sol"
# model_reasoning_effort = "high"

[agents]
enabled = true
# 上限不含主线程；3 是本示例选择，不是官方默认值。
max_concurrent_threads_per_session = 3
# default_subagent_model = "gpt-6.2-sol"
# default_subagent_reasoning_effort = "high"
