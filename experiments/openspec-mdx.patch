diff --git a/src/core/parsers/mdx-module.ts b/src/core/parsers/mdx-module.ts
new file mode 100644
--- /dev/null
+++ b/src/core/parsers/mdx-module.ts
@@ -0,0 +1,38 @@
+import { createProcessor } from '@mdx-js/mdx';
+
+/** Parse, never evaluate, an MDX document. Preserve module statements by their
+ * original source ranges, and blank them in the Markdown view so JavaScript
+ * strings cannot masquerade as OpenSpec headings. Line numbers stay stable.
+ */
+export function splitMdxModule(source: string): { markdown: string; module: string } {
+  const tree = createProcessor({ format: 'mdx' }).parse(source);
+  // The existing OpenSpec grammar reads column-zero Markdown headings. MDX
+  // permits identical bytes inside JavaScript strings or nested JSX children;
+  // those are not spec structure. Refuse that ambiguous supported shape rather
+  // than allowing a string to become an ADDED/MODIFIED/REMOVED operation.
+  const inspect = (node: { type: string; position?: { start: { offset?: number }; end: { offset?: number } }; children?: unknown[] }): void => {
+    if (node.type.startsWith('mdx') && node.type !== 'mdxjsEsm') {
+      const start = node.position?.start.offset;
+      const end = node.position?.end.offset;
+      if (start !== undefined && end !== undefined && /^#{1,4}[ \t]+/m.test(source.slice(start, end))) {
+        throw new Error('OpenSpec headings must be top-level Markdown, not embedded in MDX JSX or expressions. Escape heading-like text inside the component.');
+      }
+    }
+    for (const child of node.children ?? []) inspect(child as Parameters<typeof inspect>[0]);
+  };
+  for (const node of tree.children) inspect(node);
+  const statements: string[] = [];
+  let markdown = '';
+  let offset = 0;
+  for (const node of tree.children) {
+    if (node.type !== 'mdxjsEsm') continue;
+    const start = node.position?.start.offset;
+    const end = node.position?.end.offset;
+    if (start === undefined || end === undefined) throw new Error('MDX module is missing source positions');
+    statements.push(source.slice(start, end));
+    markdown += source.slice(offset, start) + source.slice(start, end).replace(/[^\r\n]/g, ' ');
+    offset = end;
+  }
+  markdown += source.slice(offset);
+  return { markdown, module: statements.join('\n\n') };
+}
