+import { describe, expect, it } from 'vitest';
+import { getOpsxProposeSkillTemplate, getOpsxProposeCommandTemplate } from '../../../src/core/templates/workflows/propose.js';
+import { getContinueChangeSkillTemplate, getOpsxContinueCommandTemplate } from '../../../src/core/templates/workflows/continue-change.js';
+import { getSyncSpecsSkillTemplate, getOpsxSyncCommandTemplate } from '../../../src/core/templates/workflows/sync-specs.js';
+import { getVerifyChangeSkillTemplate, getOpsxVerifyCommandTemplate } from '../../../src/core/templates/workflows/verify-change.js';
+import { getArchiveChangeSkillTemplate, getOpsxArchiveCommandTemplate } from '../../../src/core/templates/workflows/archive-change.js';
+import { getBulkArchiveChangeSkillTemplate, getOpsxBulkArchiveCommandTemplate } from '../../../src/core/templates/workflows/bulk-archive-change.js';
+import { getExploreSkillTemplate, getOpsxExploreCommandTemplate } from '../../../src/core/templates/workflows/explore.js';
+
+const bodies = () => [
+  getOpsxProposeSkillTemplate().instructions, getOpsxProposeCommandTemplate().content,
+  getContinueChangeSkillTemplate().instructions, getOpsxContinueCommandTemplate().content,
+  getSyncSpecsSkillTemplate().instructions, getOpsxSyncCommandTemplate().content,
+  getVerifyChangeSkillTemplate().instructions, getOpsxVerifyCommandTemplate().content,
+  getArchiveChangeSkillTemplate().instructions, getOpsxArchiveCommandTemplate().content,
+  getBulkArchiveChangeSkillTemplate().instructions, getOpsxBulkArchiveCommandTemplate().content,
+  getExploreSkillTemplate().instructions, getOpsxExploreCommandTemplate().content,
+];
+
+describe('canonical spec paths in generated workflows', () => {
+  it('makes both surfaces use selected-root CLI filenames, not hardcoded Markdown paths', () => {
+    expect(bodies()).toHaveLength(14);
+    for (const body of bodies()) {
+      expect(body).toContain('Canonical spec filename:');
+      expect(body).toContain('`outputPath`');
+      expect(body).toContain('`existingOutputPaths`');
+      expect(body).toContain('`planningHome.root`');
+      expect(body).toContain('Never infer the format from the invoking repository');
+      expect(body).toContain('both canonical siblings exist');
+      expect(body).toContain('Never create the opposite-extension sibling');
+      expect(body).toContain('`spec.md`');
+      expect(body).toContain('`spec.mdx`');
+      expect(body).not.toMatch(/\/spec\.md\b/);
+      expect(body).toContain('<spec-file>');
+    }
+  });
+  it('corrects verification history pathspecs and main-spec writes', () => {
+    for (const body of [getVerifyChangeSkillTemplate().instructions, getOpsxVerifyCommandTemplate().content]) {
+      expect(body).toContain('git -C "<planningHome.root>" log -p -- openspec/specs/<capability-path>/<spec-file>');
+      expect(body).toContain('show <commit>^:./openspec/specs/<capability-path>/<spec-file>');
+    }
+    for (const body of [getSyncSpecsSkillTemplate().instructions, getOpsxSyncCommandTemplate().content]) {
+      expect(body).toContain('Create `<planningHome.root>/openspec/specs/<capability-path>/<spec-file>`');
+      expect(body).toContain('never execute module code');
+      expect(body).toContain('retains the existing main spec');
+      expect(body).toContain('replace that entire preamble');
+      expect(body).toContain('Preserve requirement JSX verbatim');
+    }
+  });
+});
