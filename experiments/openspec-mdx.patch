new file mode 100644
--- /dev/null
+++ b/src/core/templates/workflows/canonical-spec.ts
@@ -0,0 +1,19 @@
+/** Keep globally installed workflow text aligned with the selected planning root. */
+const CANONICAL_SPEC_GUIDANCE = `**Canonical spec filename:** Every \`<spec-file>\` below is a placeholder, not a literal filename. Resolve it before any spec read, write, deletion, comparison, or Git history lookup. For the selected change, use the specs artifact's CLI instructions \`outputPath\` and concrete \`existingOutputPaths\` (or the equivalent selected-root status paths). Reuse an already fetched instructions snapshot rather than requesting another one. For an existing spec, preserve its confirmed canonical filename. The native default is \`spec.md\`; an explicitly MDX-configured planning root uses \`spec.mdx\`. Never infer the format from the invoking repository's configuration when a store is selected: use the same selected-root CLI flags and \`planningHome.root\` as the change. If no change exists yet, read only confirmed existing canonical spec paths; defer choosing new filenames until its artifact instructions are available.
+
+Apply that resolved filename to ALL illustrated paths below, including main specs, new delta specs, examples, and \`git log\` / \`git show\` pathspecs. Preserve capability paths and the selected planning root. If CLI instructions fail, the filename cannot be established, or both canonical siblings exist for one capability, stop before writing and report the conflict. Never create the opposite-extension sibling as a fallback. This filename rule does not rename proposal.md, design.md, tasks.md, or other artifacts.`;
+
+/** Adapt both skill and command bodies, including interpolated shared text. */
+export function withCanonicalSpecPaths<T extends { instructions?: string; content?: string }>(template: T): T {
+  const adapt = (body: string): string => {
+    const rendered = body.replace(/\bspec\.md\b/g, '<spec-file>');
+    const firstParagraph = rendered.indexOf('\n\n');
+    if (firstParagraph < 0) return `${rendered}\n\n${CANONICAL_SPEC_GUIDANCE}`;
+    return `${rendered.slice(0, firstParagraph)}\n\n${CANONICAL_SPEC_GUIDANCE}${rendered.slice(firstParagraph)}`;
+  };
+  return {
+    ...template,
+    ...(template.instructions !== undefined ? { instructions: adapt(template.instructions) } : {}),
+    ...(template.content !== undefined ? { content: adapt(template.content) } : {}),
+  };
+}
