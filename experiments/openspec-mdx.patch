new file mode 100644
--- /dev/null
+++ b/test/core/mdx-specs.test.ts
@@ -0,0 +1,78 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { splitMdxModule } from '../../src/core/parsers/mdx-module.js';
+import { findSpecUpdates, buildUpdatedSpec, writeUpdatedSpec } from '../../src/core/specs-apply.js';
+import { discoverSpecFiles, canonicalSpecName } from '../../src/utils/spec-discovery.js';
+import { Validator } from '../../src/core/validation/validator.js';
+
+let root: string;
+beforeEach(async () => { root = await mkdtemp(path.join(os.tmpdir(), 'mdx-spec-test-')); });
+afterEach(async () => { await rm(root, { recursive: true, force: true }); });
+async function put(file: string, value: string) { await mkdir(path.dirname(file), {recursive:true}); await writeFile(file,value); }
+const purpose = '## Purpose\n\nThis interactive specification explains complete shipping behavior to shoppers.';
+const rule = (n: number) => `### Requirement: Shipping\nThe store SHALL offer shipping at ${n} dollars.\n\n#### Scenario: Basket\n- **WHEN** an order is placed\n- **THEN** the price is shown\n\n<Card value={${n}} />`;
+
+describe('canonical MDX specs', () => {
+  it('keeps JavaScript heading-looking strings out of Markdown and never executes imports', () => {
+    const source = 'import secret from "not-installed"\n\nexport const text = `\n## Requirements\n`;\n\n# Real\n';
+    const result = splitMdxModule(source);
+    expect(result.module).toContain('## Requirements');
+    expect(result.markdown).not.toContain('## Requirements');
+    expect(result.markdown.split('\n')).toHaveLength(source.split('\n').length);
+    expect(result.markdown).toContain('# Real');
+  });
+  it('rejects malformed MDX before writes', () => {
+    expect(() => splitMdxModule('# Spec\n\n<Card value={ />')).toThrow();
+  });
+  it('does not interpret headings inside JSX template strings as delta operations', () => {
+    const source = '## ADDED Requirements\n\n<Card value={`\n## REMOVED Requirements\n### Requirement: Other\n`} />';
+    expect(() => splitMdxModule(source)).toThrow('top-level Markdown');
+  });
+  it('uses actual planning root rather than outer directories named openspec', () => {
+    expect(canonicalSpecName(path.join(root, 'openspec/store/loose/specs'))).toBe('spec.md');
+  });
+  it('requires explicit format and rejects ambiguous or opposite-format canonical sources', async () => {
+    const specs=path.join(root,'openspec/specs');
+    await put(path.join(specs,'nested/ship/spec.mdx'),'# MDX');
+    await expect(discoverSpecFiles(specs)).rejects.toThrow('selects spec.md');
+    await put(path.join(root,'openspec/config.yaml'),'schema: spec-driven\nspecFormat: mdx\n');
+    expect((await discoverSpecFiles(specs))[0].id).toBe('nested/ship');
+    await put(path.join(specs,'nested/ship/spec.md'),'# Markdown');
+    await expect(discoverSpecFiles(specs)).rejects.toThrow();
+  });
+  it('creates then changes MDX while retaining real module, JSX and unchanged rule', async () => {
+    await put(path.join(root,'openspec/config.yaml'),'schema: spec-driven\nspecFormat: mdx\n');
+    const change=path.join(root,'openspec/changes/add');
+    const main=path.join(root,'openspec/specs');
+    const mod='import { Card } from "card"\n\nexport const currency = "USD";';
+    const stable=rule(9).replace(/Shipping/g,'Delivery').replace(/Basket/g,'Promise');
+    await put(path.join(change,'specs/ship/spec.mdx'),`${mod}\n\n# Ship\n\n${purpose}\n\n## ADDED Requirements\n\n${rule(50)}\n\n${stable}\n`);
+    const [first]=await findSpecUpdates(change,main);
+    const built=await buildUpdatedSpec(first,'add',{silent:true});
+    expect(built.rebuilt).toContain(mod);
+    expect(built.rebuilt).toContain(stable);
+    expect(first.target).toMatch(/spec.mdx$/);
+    await writeUpdatedSpec(first,built.rebuilt,built.counts,{silent:true});
+    const second=path.join(root,'openspec/changes/update');
+    await put(path.join(second,'specs/ship/spec.mdx'),`## MODIFIED Requirements\n\n${rule(75)}\n`);
+    const [update]=await findSpecUpdates(second,main);
+    const changed=await buildUpdatedSpec(update,'update',{silent:true});
+    expect(changed.rebuilt).toContain(mod);
+    expect(changed.rebuilt).toContain(stable);
+    expect(changed.rebuilt).toContain('<Card value={75} />');
+    expect(changed.rebuilt).not.toContain('<Card value={50} />');
+    expect((await new Validator(true).validateSpecContent('ship',changed.rebuilt,'mdx')).valid).toBe(true);
+    expect(await readFile(first.target,'utf8')).toBe(built.rebuilt);
+  });
+  it('does not collapse blank lines in JSX string data', async () => {
+    await put(path.join(root,'openspec/config.yaml'),'specFormat: mdx\n');
+    const change=path.join(root,'openspec/changes/add');
+    const main=path.join(root,'openspec/specs');
+    const body=rule(50)+'\n\n<Card value={`a\n\n\n\nb`} />';
+    await put(path.join(change,'specs/ship/spec.mdx'),`# Ship\n\n${purpose}\n\n## ADDED Requirements\n\n${body}\n`);
+    const [update]=await findSpecUpdates(change,main);
+    expect((await buildUpdatedSpec(update,'add',{silent:true})).rebuilt).toContain('`a\n\n\n\nb`');
+  });
+});
