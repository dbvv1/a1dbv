diff --git a/tests/agent/test_anthropic_sdk_migration_boundary.py b/tests/agent/test_anthropic_sdk_migration_boundary.py
new file mode 100644
index 00000000..303cdb01
--- /dev/null
+++ b/tests/agent/test_anthropic_sdk_migration_boundary.py
@@ -0,0 +1,108 @@
+"""Local acceptance for the existing Anthropic 1.x migration (#118652).
+
+Exercise actual clients without any provider IO; all credentials and responses
+are synthetic. The Bedrock cases preserve the newer main timeout contract.
+"""
+from unittest.mock import patch
+
+import httpx2
+import pytest
+
+from agent import anthropic_adapter as adapter
+
+
+@pytest.fixture(autouse=True)
+def _no_provider_network(monkeypatch):
+    import socket
+
+    def refuse(*args, **kwargs):
+        raise AssertionError("This acceptance uses only the in-memory transport")
+
+    monkeypatch.setattr(socket.socket, "connect", refuse)
+    monkeypatch.setattr(socket.socket, "connect_ex", refuse)
+
+
+def _memory_wire(client, captured):
+    def receive(request):
+        captured.append(dict(request.headers))
+        return httpx2.Response(200, json={
+            "id": "msg_synthetic", "type": "message", "role": "assistant",
+            "model": "test-model", "content": [{"type": "text", "text": "ok"}],
+            "stop_reason": "end_turn", "stop_sequence": None,
+            "usage": {"input_tokens": 1, "output_tokens": 1},
+        })
+
+    # Keep the real client's auth hooks; replace only the external IO boundary.
+    client._client._transport.close()
+    client._client._transport = httpx2.MockTransport(receive)
+
+
+def _message(client):
+    reply = client.messages.create(model="test-model", max_tokens=8,
+                                   messages=[{"role": "user", "content": "synthetic"}])
+    assert reply.content[0].text == "ok"
+
+
+@pytest.mark.parametrize("base_url", [None, "https://gateway.invalid/anthropic"])
+def test_api_key_wire_and_copy_keep_one_auth_header(base_url):
+    captured = []
+    client = adapter.build_anthropic_client("sk-ant-api03-synthetic", base_url, timeout=123)
+    try:
+        assert isinstance(client.timeout, httpx2.Timeout)
+        assert (client.timeout.read, client.timeout.connect, client.max_retries) == (123, 10, 0)
+        _memory_wire(client, captured)
+        _message(client)
+        copied = client.with_options(timeout=30)
+        try:
+            _message(copied)
+        finally:
+            copied.close()
+    finally:
+        client.close()
+    assert len(captured) == 2
+    for headers in captured:
+        assert headers["x-api-key"] == "sk-ant-api03-synthetic"
+        assert "authorization" not in headers
+
+
+def test_bearer_hook_refreshes_through_real_client_and_copy():
+    minted = []
+
+    def provider():
+        token = f"synthetic-bearer-{len(minted) + 1}"
+        minted.append(token)
+        return token
+
+    captured = []
+    client = adapter.build_anthropic_client(provider, "https://example.openai.azure.com/anthropic")
+    try:
+        assert isinstance(client._client, httpx2.Client)
+        _memory_wire(client, captured)
+        _message(client)
+        copied = client.with_options(timeout=30)
+        try:
+            _message(copied)
+        finally:
+            copied.close()
+    finally:
+        client.close()
+    assert len(captured) == 2
+    assert len(minted) >= 2
+    assert captured[0]["authorization"] != captured[1]["authorization"]
+    assert captured[1]["authorization"] == "Bearer " + minted[-1]
+    for headers in captured:
+        assert "x-api-key" not in headers and "api-key" not in headers
+        assert "entra-id-bearer-via-http-hook" not in headers["authorization"]
+
+
+@pytest.mark.parametrize("timeout, expected", [(None, 900), (123, 123)])
+def test_real_bedrock_constructor_retains_current_main_timeout(timeout, expected):
+    credentials = {"aws_access_key_id": "synthetic-access", "aws_secret_access_key": "synthetic-secret"}
+    with patch("agent.bedrock_adapter.scoped_aws_session_kwargs", return_value=credentials), \
+         patch("agent.bedrock_adapter.bedrock_guardrail_headers", return_value={}):
+        client = adapter.build_anthropic_bedrock_client("us-east-2", timeout=timeout)
+    try:
+        assert isinstance(client.timeout, httpx2.Timeout)
+        assert (client.timeout.read, client.timeout.connect, client.max_retries) == (expected, 10, 0)
+    finally:
+        client.close()
