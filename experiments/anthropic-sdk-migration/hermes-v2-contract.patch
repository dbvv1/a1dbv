diff --git a/agent/anthropic_sdk2_request.py b/agent/anthropic_sdk2_request.py
new file mode 100644
index 00000000..31f74df5
--- /dev/null
+++ b/agent/anthropic_sdk2_request.py
@@ -0,0 +1,42 @@
+"""SDK 2 Messages request adaptation; not a blanket provider/API upgrade."""
+from copy import deepcopy
+
+
+def _strip_user_text_citations(blocks):
+    if not isinstance(blocks, list):
+        return
+    for block in blocks:
+        if not isinstance(block, dict):
+            continue
+        if block.get("type") == "text":
+            block.pop("citations", None)
+        elif block.get("type") in {"search_result", "tool_result"}:
+            _strip_user_text_citations(block.get("content"))
+
+
+def prepare_sdk2_message(params, *, native):
+    """Preserve legacy gateway wire fields; native non-default sampling needs old API."""
+    result = deepcopy(params)
+    sampling = {key: result.pop(key) for key in ("temperature", "top_p", "top_k") if key in result}
+    if not native:
+        if sampling:
+            result["extra_body"] = {**sampling, **result.get("extra_body", {})}
+        return result
+    extra = result.get("extra_body", {})
+    sampling.update({key: extra.pop(key) for key in ("temperature", "top_p", "top_k") if key in extra})
+    if any(key != "temperature" or value != 1 for key, value in sampling.items()):
+        raise ValueError("Non-default sampling requires the previous Anthropic API; SDK 2 cannot preserve it")
+    for message in extra.get("messages", result.get("messages", [])):
+        if message.get("role") == "user":
+            _strip_user_text_citations(message.get("content"))
+    return result
+
+
+def open_sdk2_stream(client, params, *, log_prefix=""):
+    """Apply the same request boundary on the main turn's direct streaming path."""
+    from agent.anthropic_adapter import sanitize_anthropic_kwargs
+    from agent.anthropic_credentials import is_native_anthropic_host
+    final = dict(params)
+    sanitize_anthropic_kwargs(final, log_prefix=log_prefix)
+    final = prepare_sdk2_message(final, native=is_native_anthropic_host(str(client.base_url)))
+    return client.messages.stream(**final)
