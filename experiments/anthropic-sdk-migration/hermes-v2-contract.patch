diff --git a/tests/agent/test_anthropic_sdk2_boundary.py b/tests/agent/test_anthropic_sdk2_boundary.py
new file mode 100644
index 00000000..7d689458
--- /dev/null
+++ b/tests/agent/test_anthropic_sdk2_boundary.py
@@ -0,0 +1,126 @@
+"""Actual SDK2 wire contracts using synthetic credentials and no external transport."""
+import copy
+import json
+import socket
+
+import anthropic
+import httpx2
+import pytest
+
+from agent import anthropic_adapter as adapter
+
+
+@pytest.fixture
+def wire(monkeypatch):
+    seen = []
+    def capture(transport, request):
+        body = json.loads(request.content)
+        seen.append((dict(request.headers), body))
+        return httpx2.Response(200, json={
+            "id": "msg_synthetic", "type": "message", "role": "assistant",
+            "model": body["model"], "content": [{"type": "text", "text": "ok"}],
+            "stop_reason": "end_turn", "stop_sequence": None,
+            "usage": {"input_tokens": 1, "output_tokens": 1},
+        })
+    def no_network(*args, **kwargs):
+        raise AssertionError("This contract test must not open a socket")
+    monkeypatch.setattr(httpx2.HTTPTransport, "handle_request", capture)
+    monkeypatch.setattr(socket.socket, "connect", no_network)
+    monkeypatch.setattr(adapter, "_anthropic_sdk", anthropic)
+    monkeypatch.setattr(adapter, "_custom_provider_extra_headers", lambda route: {})
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "synthetic-ambient-key")
+    monkeypatch.setenv("ANTHROPIC_AUTH_TOKEN", "synthetic-ambient-token")
+    return seen
+
+
+@pytest.mark.parametrize("base_url,key,header", [
+    ("https://api.anthropic.com", "sk-ant-api-synthetic", "x-api-key"),
+    ("https://gateway.invalid/anthropic", "synthetic-route-key", "x-api-key"),
+    ("https://api.minimax.io/anthropic", "synthetic-route-token", "authorization"),
+])
+def test_actual_builder_and_copy_keep_exactly_one_route_credential(wire, base_url, key, header):
+    client = adapter.build_anthropic_client(key, base_url=base_url, timeout=17)
+    copied = client.with_options(timeout=23)
+    try:
+        for target in (client, copied):
+            result = adapter.create_anthropic_message(target, {
+                "model": "claude-sonnet-4-5", "max_tokens": 16,
+                "messages": [{"role": "user", "content": "synthetic"}],
+            }, prefer_stream=False)
+            assert result.content[0].text == "ok"
+        assert len(wire) == 2
+        for headers, body in wire:
+            assert headers[header] == (key if header == "x-api-key" else f"Bearer {key}")
+            assert ("x-api-key" in headers) != ("authorization" in headers)
+            assert headers["anthropic-version"] == "2026-10-21"
+    finally:
+        copied.close()
+        client.close()
+
+
+def test_native_manual_thinking_payload_and_user_citations_reach_sdk2(wire):
+    citation = {"type": "char_location", "cited_text": "quote", "document_index": 0,
+                "document_title": "doc", "start_char_index": 0, "end_char_index": 5}
+    history = [{"role": "user", "content": [{"type": "text", "text": "question", "citations": [citation]}]},
+               {"role": "assistant", "content": [{"type": "text", "text": "answer", "citations": [citation]}]},
+               {"role": "user", "content": "continue"}]
+    original = copy.deepcopy(history)
+    params = adapter.build_anthropic_kwargs("claude-sonnet-4-5", history, None, 8192,
+                                          {"enabled": True, "effort": "low"})
+    client = adapter.build_anthropic_client("sk-ant-api-synthetic", timeout=17)
+    try:
+        adapter.create_anthropic_message(client, params, prefer_stream=False)
+        assert len(wire) == 1
+        _headers, body = wire[0]
+        assert not {"temperature", "top_p", "top_k"} & body.keys()
+        assert "citations" not in body["messages"][0]["content"][0]
+        assert body["messages"][1]["content"][0]["citations"] == [citation]
+        assert history == original
+    finally:
+        client.close()
+
+
+def test_legacy_gateway_sampling_is_preserved_and_native_nondefault_rejected(wire):
+    params = {"model": "claude-sonnet-4-5", "max_tokens": 16, "temperature": 0.2,
+              "messages": [{"role": "user", "content": "synthetic"}]}
+    with adapter.build_anthropic_client("synthetic", base_url="https://gateway.invalid") as client:
+        adapter.create_anthropic_message(client, params, prefer_stream=False)
+    assert wire[0][1]["temperature"] == 0.2
+    assert params["temperature"] == 0.2
+    with adapter.build_anthropic_client("sk-ant-api-synthetic") as client:
+        with pytest.raises(ValueError, match="previous Anthropic API"):
+            adapter.create_anthropic_message(client, params, prefer_stream=False)
+    assert len(wire) == 1
+
+
+def test_callable_token_refresh_survives_sdk_copy(wire):
+    tokens = iter(["synthetic-first", "synthetic-second"])
+    client = adapter.build_anthropic_client(lambda: next(tokens), base_url="https://gateway.invalid")
+    copied = client.with_options()
+    try:
+        for target in (client, copied):
+            adapter.create_anthropic_message(target, {
+                "model": "claude-sonnet-4-5", "max_tokens": 16,
+                "messages": [{"role": "user", "content": "synthetic"}],
+            }, prefer_stream=False)
+        assert [headers["authorization"] for headers, _ in wire] == ["Bearer synthetic-first", "Bearer synthetic-second"]
+        assert all("x-api-key" not in headers for headers, _ in wire)
+    finally:
+        copied.close()
+        client.close()
+
+
+@pytest.mark.parametrize("value", [0.3, 1])
+def test_native_extra_body_sampling_cannot_hide_from_migration(wire, value):
+    params = {"model": "claude-sonnet-4-5", "max_tokens": 16,
+              "messages": [{"role": "user", "content": "synthetic"}],
+              "extra_body": {"temperature": value}}
+    with adapter.build_anthropic_client("sk-ant-api-synthetic") as client:
+        if value != 1:
+            with pytest.raises(ValueError, match="previous Anthropic API"):
+                adapter.create_anthropic_message(client, params, prefer_stream=False)
+            assert not wire
+        else:
+            adapter.create_anthropic_message(client, params, prefer_stream=False)
+            assert "temperature" not in wire[0][1]
+    assert params["extra_body"]["temperature"] == value
