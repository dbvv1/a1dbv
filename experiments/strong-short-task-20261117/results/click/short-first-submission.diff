+def test_auto_envvar_error(runner, option_kwargs, expected, args, message):
+    option_kwargs = {"show_envvar": True, **option_kwargs}
+
+    @click.command(context_settings={"auto_envvar_prefix": "MYAPP"})
+    @click.option("--port", type=int, required=True, **option_kwargs)
+    def cli(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(
+        cli, args, env={"MYAPP_PORT": None, "FIRST_PORT": None, "PORT": None}
+    )
+    assert result.exit_code == 2
+    assert result.stdout == ""
+    assert result.stderr.endswith(f"Error: {message.format(hint=expected)}\n")
+
+
+@pytest.mark.parametrize(
+    ("envvar", "expected"),
+    [(None, "'--port'"), ("PORT", "'--port' (env var: 'PORT')")],
+)
+def test_envvar_error_without_context(envvar, expected):
+    option = click.Option(["--port"], envvar=envvar, show_envvar=True)
+    assert (
+        click.MissingParameter(param=option).format_message()
+        == f"Missing option {expected}."
+    )
+    assert (
+        click.BadParameter("invalid", param=option).format_message()
+        == f"Invalid value for {expected}: invalid"
+    )
+
+
+@pytest.mark.parametrize(
+    ("args", "env", "expected"),
+    [
+        ([], {"MYAPP_PORT": "8001"}, 8001),
+        ([], {"MYAPP_PORT": "8001", "PORT": "8002"}, 8002),
+        ([], {"MYAPP_PORT": "8001", "PORT": "8002", "FIRST_PORT": "8003"}, 8003),
+        ([], {"MYAPP_PORT": "8001", "PORT": "8002", "FIRST_PORT": ""}, 8002),
+        ([], {"MYAPP_PORT": "8001", "PORT": "", "FIRST_PORT": ""}, 8001),
+        (
+            ["--port", "8004"],
+            {"MYAPP_PORT": "oops", "PORT": "oops", "FIRST_PORT": "oops"},
+            8004,
+        ),
+    ],
+)
+def test_show_envvar_auto_prefix_values(runner, args, env, expected):
+    @click.command(context_settings={"auto_envvar_prefix": "MYAPP"})
+    @click.option(
+        "--port",
+        type=int,
+        required=True,
+        envvar=["FIRST_PORT", "PORT"],
+        show_envvar=True,
+    )
+    def cli(port):
+        click.echo(f"port={port}")
+
+    env = {"MYAPP_PORT": None, "FIRST_PORT": None, "PORT": None, **env}
+    result = runner.invoke(cli, args, env=env)
+    assert result.exit_code == 0
+    assert result.output == f"port={expected}\n"
+
