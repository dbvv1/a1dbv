+            "'--port' (env var: 'FIRST_PORT', 'PORT')",
+        ),
+        ({"show_envvar": False}, "'--port'"),
+        ({"envvar": "PORT", "show_envvar": False}, "'--port'"),
+        ({"allow_from_autoenv": False}, "'--port'"),
+        (
