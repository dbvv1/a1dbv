+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True])
+@pytest.mark.parametrize("omitted", ["new", "old", "unique"])
+async def test_chat_filter_acknowledges_only_sent_occurrence(streamed: bool, omitted: str) -> None:
+    requests: list[dict[str, Any]] = []
+
+    @tool(needs_approval=True)
+    def lookup() -> str:
+        return "lookup-result"
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        body = json.loads(request.content)
+        requests.append(body)
+        return _wire_response(
+            body,
+            chat=True,
+            call_name="lookup" if len(requests) <= 2 else None,
+            call_id=f"call_{len(requests)}",
+        )
+
+    def filter_input(data: CallModelData[Any]) -> ModelInputData:
+        items = data.model_data.input
+        matches = [index for index, item in enumerate(items) if item.get("content") == "Repeat"]
+        drop = matches[0] if omitted == "old" else matches[-1]
+        return ModelInputData(
+            input=[item for index, item in enumerate(items) if index != drop],
+            instructions=data.model_data.instructions,
+        )
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        agent = Agent(
+            name="test", model=OpenAIChatCompletionsModel("synthetic-model", client), tools=[lookup]
+        )
+        first = await Runner.run(
+            agent,
+            "Earlier" if omitted == "unique" else "Repeat",
+            conversation_id="conv_test",
+            run_config=RunConfig(tracing_disabled=True),
+        )
+        state = await RunState.from_json(agent, first.to_state().to_json())
+        state.approve(state.get_interruptions()[0])
+        state.add_input("Repeat")
+        filtered_config = RunConfig(tracing_disabled=True, call_model_input_filter=filter_input)
+        if streamed:
+            second = Runner.run_streamed(agent, state, run_config=filtered_config)
+            async for _ in second.stream_events():
+                pass
+        else:
+            second = await Runner.run(agent, state, run_config=filtered_config)
+        next_state = await RunState.from_json(agent, second.to_state().to_json())
+        expected_pending = [] if omitted == "old" else [{"role": "user", "content": "Repeat"}]
+        assert next_state.pending_input == expected_pending
+        assert sum(item.get("content") == "Repeat" for item in requests[1]["messages"]) == (
+            0 if omitted == "unique" else 1
+        )
+        assert (
+            sum(item.get("content") == "Repeat" for item in second.to_input_list())
+            == {"new": 1, "old": 2, "unique": 0}[omitted]
+        )
+        next_state.approve(next_state.get_interruptions()[0])
+        config = RunConfig(tracing_disabled=True)
+        if streamed:
+            final = Runner.run_streamed(agent, next_state, run_config=config)
+            async for _ in final.stream_events():
+                pass
+        else:
+            final = await Runner.run(agent, next_state, run_config=config)
+        assert final.final_output == "done"
+        assert final.to_state().pending_input == []
+        assert sum(item.get("content") == "Repeat" for item in requests[2]["messages"]) == (
+            1 if omitted == "unique" else 2
+        )
