+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True])
+@pytest.mark.parametrize("rewrite_history", [False, True])
+async def test_chat_resume_acknowledges_added_input(streamed: bool, rewrite_history: bool) -> None:
+    requests: list[dict[str, Any]] = []
+
+    @tool(needs_approval=True)
+    def lookup() -> str:
+        return "lookup-result"
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        body = json.loads(request.content)
+        requests.append(body)
+        return _wire_response(
+            body,
+            chat=True,
+            call_name="lookup" if len(requests) <= 2 else None,
+            call_id=f"call_{len(requests)}",
+        )
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        agent = Agent(
+            name="test", model=OpenAIChatCompletionsModel("synthetic-model", client), tools=[lookup]
+        )
+        config = RunConfig(tracing_disabled=True)
+        first = await Runner.run(agent, "hello", run_config=config, conversation_id="conv_test")
+        state = first.to_state()
+        state.approve(state.get_interruptions()[0])
+        state.add_input("Remember late input")
+        if streamed:
+            second = Runner.run_streamed(agent, state, run_config=config)
+            async for _ in second.stream_events():
+                pass
+        else:
+            second = await Runner.run(agent, state, run_config=config)
+        assert any(
+            message.get("content") == "Remember late input" for message in requests[1]["messages"]
+        )
+        next_state = second.to_state()
+        assert next_state.pending_input == []
+        assert (
+            sum(item.get("content") == "Remember late input" for item in second.to_input_list())
+            == 1
+        )
+        next_state.approve(next_state.get_interruptions()[0])
+        if rewrite_history:
+
+            def summarize_accepted_input(data: CallModelData[Any]) -> ModelInputData:
+                return ModelInputData(
+                    input=[
+                        item
+                        for item in data.model_data.input
+                        if item.get("content") != "Remember late input"
+                    ]
+                    + [{"role": "user", "content": "Accepted input summary"}],
+                    instructions=data.model_data.instructions,
+                )
+
+            config = RunConfig(
+                tracing_disabled=True, call_model_input_filter=summarize_accepted_input
+            )
+        if streamed:
