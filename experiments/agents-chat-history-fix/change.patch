+            async for _ in final.stream_events():
+                pass
+        else:
+            final = await Runner.run(agent, next_state, run_config=config)
+        assert final.final_output == "done"
+        assert sum(
+            message.get("content") == "Remember late input" for message in requests[2]["messages"]
+        ) == (0 if rewrite_history else 1)
+
+        if rewrite_history:
+            assert any(
+                item.get("content") == "Accepted input summary" for item in requests[2]["messages"]
+            )
