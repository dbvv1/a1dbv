index 0000000000000000000000000000000000000000..0eb90c17f1db486b321b72964de1ead44193715c
--- /dev/null
+++ b/tests/models/test_chat_server_state_history.py
@@ -0,0 +1,532 @@
+"""Exercise Runner history at the provider wire boundary, not a scripted-model shortcut."""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any
+
+import httpx2
+import pytest
+from openai import AsyncOpenAI
+
+from agents import (
+    Agent,
+    Model,
+    ModelProvider,
+    OpenAIChatCompletionsModel,
+    OpenAIResponsesModel,
+    RunConfig,
+    Runner,
+    RunState,
+)
+from agents.decorators import tool
+from agents.exceptions import UserError
+from agents.run import CallModelData, ModelInputData
+
+
+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True], ids=["run", "run-streamed"])
+@pytest.mark.parametrize(
+    "state", ["none", "conversation_id", "previous_response_id", "auto_previous_response_id"]
+)
+async def test_chat_tool_turn_preserves_history(
+    streamed: bool, state: str, caplog: pytest.LogCaptureFixture
+) -> None:
+    caplog.set_level(logging.WARNING, logger="openai.agents")
+    requests: list[dict[str, Any]] = []
+
+    @tool
+    def lookup() -> str:
+        return "lookup-result"
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        assert request.url.path == "/v1/chat/completions"
+        body = json.loads(request.content)
+        requests.append(body)
+        return _wire_response(
+            body,
+            chat=True,
+            call_name="lookup" if len(requests) < 3 else None,
+            call_id=f"call_{len(requests)}",
+        )
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        model = OpenAIChatCompletionsModel(model="synthetic-model", openai_client=client)
+        agent = Agent(name="test", model=model, tools=[lookup])
+        config = RunConfig(tracing_disabled=True)
+        kwargs: dict[str, Any] = {}
+        if state == "conversation_id":
+            kwargs["conversation_id"] = "conv_test"
+        elif state == "previous_response_id":
+            kwargs["previous_response_id"] = "resp_test"
+        elif state == "auto_previous_response_id":
+            kwargs["auto_previous_response_id"] = True
+        if streamed:
+            result = Runner.run_streamed(agent, "hello", run_config=config, **kwargs)
+            async for _ in result.stream_events():
+                pass
+        else:
+            result = await Runner.run(agent, "hello", run_config=config, **kwargs)
+        assert result.final_output == "done"
+    assert len(requests) == 3
+    assert [message["role"] for message in requests[1]["messages"]] == ["user", "assistant", "tool"]
+    messages = requests[2]["messages"]
+    assert [message["role"] for message in messages] == [
+        "user",
+        "assistant",
+        "tool",
+        "assistant",
+        "tool",
+    ]
+    assert messages[0]["content"] == "hello"
+    assert messages[1]["tool_calls"][0]["id"] == "call_1"
+    assert messages[2]["tool_call_id"] == "call_1"
+    assert messages[2]["content"] == "lookup-result"
+    assert messages[3]["tool_calls"][0]["id"] == "call_2"
+    assert messages[4]["tool_call_id"] == "call_2"
+    assert messages[4]["content"] == "lookup-result"
+    assert all(
+        "conversation" not in request and "previous_response_id" not in request
+        for request in requests
+    )
+
+    if state in {"conversation_id", "previous_response_id"}:
+        assert "Ignoring unsupported server-managed conversation state" in caplog.text
+
+
+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True])
+@pytest.mark.parametrize("state", ["conversation_id", "previous_response_id"])
+async def test_chat_strict_state_rejects_before_request(streamed: bool, state: str) -> None:
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        pytest.fail("Strict validation must reject before sending an HTTP request.")
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        agent = Agent(
+            name="test",
+            model=OpenAIChatCompletionsModel(
+                model="synthetic-model",
+                openai_client=client,
+                strict_feature_validation=True,
+            ),
+        )
+        kwargs: dict[str, Any] = {state: "synthetic-id"}
+        with pytest.raises(UserError, match="server-managed conversation state"):
+            if streamed:
+                result = Runner.run_streamed(
+                    agent, "hello", run_config=RunConfig(tracing_disabled=True), **kwargs
+                )
+                async for _ in result.stream_events():
+                    pass
+            else:
+                await Runner.run(
+                    agent, "hello", run_config=RunConfig(tracing_disabled=True), **kwargs
+                )
+
+
+def _wire_response(
+    body: dict[str, Any], *, chat: bool, call_name: str | None, call_id: str = "call_test"
+) -> httpx2.Response:
+    # A real adapter and mock HTTP transport preserve serialization and SSE conversion.
+    if chat:
+        message: dict[str, Any] = {"role": "assistant", "content": None if call_name else "done"}
+        if call_name:
+            message["tool_calls"] = [
+                {
+                    "id": call_id,
+                    "type": "function",
+                    "function": {"name": call_name, "arguments": "{}"},
+                }
+            ]
+        payload: dict[str, Any] = {
+            "id": "chatcmpl_test",
+            "object": "chat.completion",
+            "created": 0,
+            "model": "synthetic-model",
+            "choices": [
+                {
+                    "index": 0,
+                    "message": message,
+                    "finish_reason": "tool_calls" if call_name else "stop",
+                }
+            ],
+        }
+        if body.get("stream"):
+            if call_name:
+                message["tool_calls"][0]["index"] = 0
+            payload["object"] = "chat.completion.chunk"
+            choice = payload["choices"][0]
+            choice["delta"] = choice.pop("message")
+            return httpx2.Response(
+                200,
+                headers={"content-type": "text/event-stream"},
+                content=f"data: {json.dumps(payload)}\n\ndata: [DONE]\n\n",
+            )
+    else:
+        output = (
+            {
+                "type": "function_call",
+                "id": "fc_test",
+                "call_id": call_id,
+                "name": call_name,
+                "arguments": "{}",
+                "status": "completed",
+            }
+            if call_name
+            else {
+                "type": "message",
+                "id": "msg_test",
+                "role": "assistant",
+                "status": "completed",
+                "content": [{"type": "output_text", "text": "done", "annotations": []}],
+            }
+        )
+        payload = {
+            "id": "resp_first" if call_name else "resp_final",
+            "object": "response",
+            "created_at": 0,
+            "model": "synthetic-model",
+            "status": "completed",
+            "output": [output],
+            "parallel_tool_calls": True,
+            "tool_choice": "auto",
+            "tools": [],
+        }
+        if body.get("stream"):
+            events = [
+                {
+                    "type": "response.output_item.done",
+                    "output_index": 0,
+                    "item": output,
+                    "sequence_number": 0,
+                },
+                {"type": "response.completed", "response": payload, "sequence_number": 1},
+            ]
+            return httpx2.Response(
+                200,
+                headers={"content-type": "text/event-stream"},
+                content="".join(
+                    f"event: {event['type']}\ndata: {json.dumps(event)}\n\n" for event in events
+                ),
+            )
+    return httpx2.Response(200, json=payload)
+
+
+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True])
+@pytest.mark.parametrize(
+    "state", ["conversation_id", "previous_response_id", "auto_previous_response_id"]
+)
+async def test_responses_tool_turn_keeps_server_delta(streamed: bool, state: str) -> None:
+    requests: list[dict[str, Any]] = []
+
+    @tool
+    def lookup() -> str:
+        return "lookup-result"
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        assert request.url.path == "/v1/responses"
+        body = json.loads(request.content)
+        requests.append(body)
+        return _wire_response(body, chat=False, call_name="lookup" if len(requests) == 1 else None)
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        agent = Agent(
+            name="test", model=OpenAIResponsesModel("synthetic-model", client), tools=[lookup]
+        )
+        kwargs: dict[str, Any] = {
+            state: True if state == "auto_previous_response_id" else "synthetic-id"
+        }
+        if streamed:
+            result = Runner.run_streamed(
+                agent, "hello", run_config=RunConfig(tracing_disabled=True), **kwargs
+            )
+            async for _ in result.stream_events():
+                pass
+        else:
+            result = await Runner.run(
+                agent, "hello", run_config=RunConfig(tracing_disabled=True), **kwargs
+            )
+        assert result.final_output == "done"
+    assert len(requests) == 2
+    assert requests[0]["input"] == [{"role": "user", "content": "hello"}]
+    assert requests[1]["input"] == [
+        {"type": "function_call_output", "call_id": "call_test", "output": "lookup-result"}
+    ]
+    if state == "conversation_id":
+        assert requests[1]["conversation"] == "synthetic-id"
+        assert "previous_response_id" not in requests[1]
+    else:
+        assert requests[1]["previous_response_id"] == "resp_first"
+
+
+@pytest.mark.allow_call_model_methods
+@pytest.mark.parametrize("streamed", [False, True])
+@pytest.mark.parametrize("chat_first", [False, True])
+async def test_mixed_model_handoff_replays_history(streamed: bool, chat_first: bool) -> None:
+    requests: list[dict[str, Any]] = []
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        body = json.loads(request.content)
+        requests.append(body)
+        return _wire_response(
+            body,
+            chat=request.url.path.endswith("chat/completions"),
+            call_name="transfer_to_target" if len(requests) == 1 else None,
+        )
+
+    async with AsyncOpenAI(
+        api_key="test-placeholder",
+        base_url="https://example.test/v1",
+        http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handle)),
+    ) as client:
+        chat = OpenAIChatCompletionsModel("synthetic-model", client)
+        responses = OpenAIResponsesModel("synthetic-model", client)
+        target = Agent(name="target", model=responses if chat_first else chat)
+        start = Agent(name="start", model=chat if chat_first else responses, handoffs=[target])
+        if streamed:
+            result = Runner.run_streamed(
+                start, "hello", run_config=RunConfig(tracing_disabled=True)
+            )
+            async for _ in result.stream_events():
+                pass
+        else:
+            result = await Runner.run(start, "hello", run_config=RunConfig(tracing_disabled=True))
+        assert result.final_output == "done"
+        assert result.last_agent is target
+    assert len(requests) == 2
+    if chat_first:
+        assert requests[1]["input"][0] == {"role": "user", "content": "hello"}
+        assert [item.get("type") for item in requests[1]["input"][1:]] == [
+            "function_call",
+            "function_call_output",
+        ]
+    else:
+        assert [message["role"] for message in requests[1]["messages"]] == [
+            "user",
+            "assistant",
+            "tool",
+        ]
+
