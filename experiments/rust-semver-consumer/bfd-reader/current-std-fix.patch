+
+/// Without crypto, installed keyed auth must neither leak the key nor
+/// silently fall back to the configured Simple Password (RFC 5880 §6.7).
+#[cfg(not(feature = "keyed-auth"))]
+#[test]
+fn unsupported_keyed_auth_fails_closed_and_clearing_restores_password() {
+    for algorithm in [
+        KeyedAuthAlgorithm::KeyedMd5,
+        KeyedAuthAlgorithm::MeticulousKeyedMd5,
+        KeyedAuthAlgorithm::KeyedSha1,
+        KeyedAuthAlgorithm::MeticulousKeyedSha1,
+    ] {
+        for password in [
+            None,
+            Some(crate::auth::AuthKey::new(7, b"password".to_vec())),
+        ] {
+            let mut cfg = cfg_100ms();
+            cfg.auth_key = password;
+            let mut s = BfdSession::new(cfg.clone(), 0x11111111);
+            let mut peer = BfdSession::new(cfg, 0x22222222);
+            peer.start(Instant(0));
+            let wire = peer.drain_outgoing();
+            assert!(!wire.is_empty());
+            s.set_keyed_auth(Some(
+                BfdKeyedAuth::new(5, algorithm, b"shared-secret".to_vec()).unwrap(),
+            ));
+            assert!(!s
+                .start(Instant(0))
+                .contains(&BfdSessionEvent::OutboundQueued));
+            assert!(s.drain_outgoing().is_empty());
+            assert!(s.feed_bytes(Instant(1), &[]).is_empty());
+            assert!(s.feed_bytes(Instant(2), &[0]).is_empty());
+            let events = s.feed_bytes(Instant(3), &wire);
+            assert!(events.contains(&BfdSessionEvent::AuthFailed));
+            assert_eq!(s.state(), State::Down);
+            assert!(!s
+                .tick(Instant(2000))
+                .contains(&BfdSessionEvent::OutboundQueued));
+            assert!(s.drain_outgoing().is_empty());
+            let rng = s.rng;
+            assert!(s.tick(Instant(2000)).is_empty());
+            assert_eq!(s.rng, rng, "no immediate retry at the same instant");
+            assert_eq!(s.last_tx_ms, 0, "no transmission occurred");
+            let auth = s.keyed_auth().unwrap();
+            assert_eq!(auth.xmit_seq(), 0);
+            assert!(!auth.rcv_auth_seq_known());
+            s.set_keyed_auth(None);
+            let events = s.feed_bytes(Instant(2001), &wire);
+            assert!(!events.contains(&BfdSessionEvent::AuthFailed));
+            assert_eq!(s.state(), State::Init);
+            s.tick(Instant(4000));
+            let out = s.drain_outgoing();
+            assert!(!out.is_empty());
+            assert_eq!(decode_first(&out).auth, decode_first(&wire).auth);
+        }
+    }
+}
