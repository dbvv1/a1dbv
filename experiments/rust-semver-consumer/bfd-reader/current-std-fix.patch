+#[cfg(not(feature = "keyed-auth"))]
+#[test]
+fn unsupported_keyed_auth_preserves_queue_and_detection_then_recovers_on_tick() {
+    let mut s = make_session();
+    let wire = encode_packet(&make_packet(State::Down, 0x22222222, 0));
+    s.feed_bytes(Instant(1), &wire);
+    assert_eq!(s.state(), State::Init);
+    let queued = s.out_buf.clone();
+    assert!(!queued.is_empty());
+    s.set_keyed_auth(Some(keyed_md5_auth()));
+    assert_eq!(s.drain_outgoing(), queued);
+    let events = s.feed_bytes(Instant(299), &wire);
+    assert!(events.contains(&BfdSessionEvent::AuthFailed));
+    assert!(s.tick(Instant(302)).contains(&BfdSessionEvent::Timeout));
+    assert_eq!(s.state(), State::Down);
+    assert!(s.drain_outgoing().is_empty());
+    assert!(!s
+        .tick(Instant(2000))
+        .contains(&BfdSessionEvent::OutboundQueued));
+    s.set_keyed_auth(None);
+    assert!(s
+        .tick(Instant(4000))
+        .contains(&BfdSessionEvent::OutboundQueued));
+    let out = s.drain_outgoing();
+    assert!(!out.is_empty());
+    assert!(decode_first(&out).auth.is_none());
+}
