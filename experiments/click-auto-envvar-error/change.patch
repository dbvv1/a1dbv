@@ -1202,6 +1202,100 @@ def test_missing_envvar_sequence(runner, envvar, expected):
     assert f"Error: Missing option {expected}." in result.output


+@pytest.mark.parametrize(
+    ("envvar", "expected"),
+    [
+        (None, "'MYAPP_PORT'"),
+        ([], "'MYAPP_PORT'"),
+        ((), "'MYAPP_PORT'"),
+        ("", "'MYAPP_PORT'"),
+        ("PORT", "'PORT'"),
+        (["PORT", "OTHER_PORT"], "'PORT', 'OTHER_PORT'"),
+    ],
+)
+@pytest.mark.parametrize("source", ["missing", "commandline", "environment"])
+def test_auto_envvar_error_hint(runner, envvar, expected, source):
+    @click.command(context_settings={"auto_envvar_prefix": "myapp"})
+    @click.option("--port", type=int, required=True, envvar=envvar, show_envvar=True)
+    def cli(port):
+        click.echo(port)
+
+    args = []
+    env = {"MYAPP_PORT": None, "PORT": None, "OTHER_PORT": None}
+
+    if source == "commandline":
+        args = ["--port", "invalid"]
+    elif source == "environment":
+        env["MYAPP_PORT"] = "invalid"
+
+    result = runner.invoke(cli, args, env=env)
+    assert result.exit_code == 2
+    hint = f"'--port' (env var: {expected})"
+
+    if source == "missing":
+        assert f"Error: Missing option {hint}." in result.output
+    else:
+        assert f"Error: Invalid value for {hint}:" in result.output
+
+
+@pytest.mark.parametrize(
+    ("show_envvar", "allow_from_autoenv"), [(False, True), (True, False)]
+)
+def test_auto_envvar_error_hint_disabled(runner, show_envvar, allow_from_autoenv):
+    @click.command(context_settings={"auto_envvar_prefix": "MYAPP"})
+    @click.option(
+        "--port",
+        required=True,
+        show_envvar=show_envvar,
+        allow_from_autoenv=allow_from_autoenv,
+    )
+    def cli(port):
+        pass
+
+    result = runner.invoke(cli, env={"MYAPP_PORT": None})
+    assert result.exit_code == 2
+    assert "Error: Missing option '--port'." in result.output
+
+
+def test_auto_envvar_error_hint_nested(runner):
+    @click.group(context_settings={"auto_envvar_prefix": "my-app"})
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--listen-port", type=int, required=True, show_envvar=True)
+    def serve_app(listen_port):
+        click.echo(listen_port)
+
+    result = runner.invoke(
+        cli, ["serve-app"], env={"MY_APP_SERVE_APP_LISTEN_PORT": None}
+    )
+    assert result.exit_code == 2
+    assert (
+        "Error: Missing option '--listen-port'"
+        " (env var: 'MY_APP_SERVE_APP_LISTEN_PORT')."
+    ) in result.output
+
+    result = runner.invoke(
+        cli, ["serve-app"], env={"MY_APP_SERVE_APP_LISTEN_PORT": "8080"}
+    )
+    assert result.exit_code == 0
+    assert result.output == "8080\n"
+
+
+@pytest.mark.parametrize("envvar", [None, [], "", "PORT", ["PORT", "OTHER_PORT"]])
+def test_envvar_error_hint_without_context(envvar):
+    option = click.Option(["--port"], envvar=envvar, show_envvar=True)
+    message = click.MissingParameter(param=option).format_message()
+
+    if envvar == "PORT":
+        assert message == "Missing option '--port' (env var: 'PORT')."
+    elif envvar:
+        assert message == "Missing option '--port' (env var: 'PORT', 'OTHER_PORT')."
+    else:
+        assert message == "Missing option '--port'."
+
+
