@@ -0,0 +1,66 @@
+import { afterEach, expect, expectTypeOf, it, vi } from 'vitest';
+
+import { config } from './load-config';
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.resetModules();
+});
+
+it('exposes the runtime types of configuration values', () => {
+  expectTypeOf(config.get('token_expiration')).toEqualTypeOf<
+    number | 'never' | 'openid-provider'
+  >();
+  expectTypeOf(config.get('simplefinAllowedNetworks')).toEqualTypeOf<
+    string[]
+  >();
+  expectTypeOf(config.get('trustedAuthProxies')).toEqualTypeOf<string[]>();
+  expectTypeOf(config.get('https')).toEqualTypeOf<{
+    doc: string;
+    key: string;
+    cert: string;
+  }>();
+  expectTypeOf(config.get('upload')).toEqualTypeOf<{
+    doc: string;
+    fileSizeSyncLimitMB: number;
+    syncEncryptedFileSizeLimitMB: number;
+    fileSizeLimitMB: number;
+  }>();
+
+  expect(config.get('https')).toEqual({
+    doc: 'HTTPS configuration.',
+    key: '',
+    cert: '',
+  });
+  expect(config.get('simplefinAllowedNetworks')).toEqual([]);
+});
+
+it.each([
+  ['never', 'never'],
+  ['openid-provider', 'openid-provider'],
+  ['0', 0],
+  ['86400', 86400],
+] as const)(
+  'loads token expiration %s with its runtime type',
+  async (input, expected) => {
+    vi.stubEnv('ACTUAL_TOKEN_EXPIRATION', input);
+    const { config: loaded } = await import('./load-config');
+    expect(loaded.get('token_expiration')).toBe(expected);
+  },
+);
+
+it.each(['invalid', '-1', 'Infinity'])(
+  'rejects invalid token expiration %s while loading',
+  async input => {
+    vi.stubEnv('ACTUAL_TOKEN_EXPIRATION', input);
+    await expect(import('./load-config')).rejects.toThrow(
+      /Invalid token_expiration value/,
+    );
+  },
+);
+
+it('coerces an environment port without changing the config contract', async () => {
+  vi.stubEnv('ACTUAL_PORT', '5012');
+  const { config: loaded } = await import('./load-config');
+  expect(loaded.get('port')).toBe(5012);
+});
