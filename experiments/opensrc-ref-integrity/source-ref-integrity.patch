+use std::fs;
+use std::path::PathBuf;
+use std::process::Command;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+struct CacheFixture(PathBuf);
+
+impl CacheFixture {
+    fn new() -> Self {
+        let nonce = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root =
+            std::env::temp_dir().join(format!("opensrc-ref-cache-{}-{nonce}", std::process::id()));
+        fs::create_dir(&root).unwrap();
+        let fixture = Self(root);
+        fs::create_dir_all(fixture.0.join("repos/github.com/owner/repo/main")).unwrap();
+        fs::write(
+            fixture
+                .0
+                .join("repos/github.com/owner/repo/main/source.txt"),
+            "cached main",
+        )
+        .unwrap();
+        fixture
+    }
+}
+
+impl Drop for CacheFixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn invalid_repo_refs_are_rejected_before_metadata_cache_hits() {
+    let cache = CacheFixture::new();
+    for git_ref in [
+        "",
+        ":x",
+        ":",
+        "main:other",
+        "--tags",
+        "--upload-pack=not-a-command",
+        "main*",
+    ] {
+        let index = serde_json::json!({
+            "repos": [{
+                "name": "github.com/owner/repo",
+                "version": git_ref,
+                "path": "repos/github.com/owner/repo",
+                "fetchedAt": "2026-01-01T00:00:00Z"
+            }]
+        });
+        fs::write(cache.0.join("sources.json"), index.to_string()).unwrap();
+
+        let output = Command::new(env!("CARGO_BIN_EXE_opensrc"))
+            .args(["path", &format!("owner/repo@{git_ref}")])
+            .env("OPENSRC_HOME", &cache.0)
+            .output()
+            .unwrap();
+
+        assert!(
+            !output.status.success(),
+            "invalid ref {git_ref:?} must not return a cached path"
+        );
+        assert!(output.stdout.is_empty());
+        assert!(String::from_utf8_lossy(&output.stderr).contains("Invalid repository format"));
+        assert_eq!(
+            fs::read_to_string(cache.0.join("repos/github.com/owner/repo/main/source.txt"))
+                .unwrap(),
+            "cached main"
+        );
+    }
+}
