+pub fn validate_repo_ref(git_ref: &str) -> Result<()> {
+    if git_ref.is_empty() {
+        return Err(Error::InvalidRepoSpec(
+            "repository ref must not be empty".to_string(),
+        ));
     }
+    // check-ref-format does not accept --, so do not let the ref become an option.
+    if git_ref.starts_with('-') {
+        return Err(Error::InvalidRepoSpec(format!(
+            "invalid repository ref {git_ref:?}"
+        )));
+    }
+    let output = git_output(&["check-ref-format", "--allow-onelevel", git_ref])?;
+    if !output.status.success() {
+        return Err(Error::InvalidRepoSpec(format!(
+            "expected a single branch, tag, or commit, got {git_ref:?}"
+        )));
+    }
+    Ok(())
+}
 
