 class CitationsEdgeTest(unittest.TestCase):
+    def test_duplicate_appendix_ids_are_findings_even_when_cited(self):
+        text = (
+            "Facts [1] [2].\n\n| # | Source |\n|---|---|\n"
+            "| [2] | first b |\n| [1] | first a |\n| [2] | second b |\n"
+            "| [1] | second a |\n| [1] | third a |\n"
+        )
+        code, result = run_text(["citations"], text)
+        self.assertEqual(result["appendix_rows"], [1, 2])
+        self.assertEqual(result["duplicate_rows"], [1, 2])
+        self.assertEqual(result["dangling_markers"], [])
+        self.assertEqual(result["orphaned_rows"], [])
+        self.assertFalse(result["ok"])
+        self.assertEqual(code, 1)
+
+    def test_backticks_in_source_cells_cannot_hide_duplicate_rows(self):
+        text = "Fact [1].\n\n| [1] | first `source |\n| [1] | second source` |\n"
+        code, result = run_text(["citations"], text)
+        self.assertEqual(result["markers"], [1])
+        self.assertEqual(result["duplicate_rows"], [1])
+        self.assertFalse(result["ok"])
+        self.assertEqual(code, 1)
+
