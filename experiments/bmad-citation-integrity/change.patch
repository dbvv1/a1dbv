 class EscapeSourcesTest(unittest.TestCase):
+    def test_duplicate_ids_fail_without_dropping_sources_or_repeating_html_ids(self):
+        text = (
+            "Fact [1].\n\n| # | Source |\n|---|---|\n"
+            "| [1] | first https://example.com/a |\n| [1] | second https://example.com/b |\n"
+        )
+        code, result = run_text(["escape-sources"], text)
+        self.assertEqual(result["rows"], 2)
+        self.assertEqual(result["duplicate_rows"], [1])
+        self.assertIn('href="https://example.com/a"', result["html"])
+        self.assertIn('href="https://example.com/b"', result["html"])
+        self.assertLess(result["html"].index("first"), result["html"].index("second"))
+        self.assertEqual(result["html"].count('id="src-1"'), 1)
+        self.assertEqual(code, 1)
+
+    def test_duplicate_rows_still_escape_cells_and_report_invalid_urls(self):
+        text = "| [1] | <script> |\n| [1] | [bad](javascript:alert(1)) |\n"
+        code, result = run_text(["escape-sources"], text)
+        self.assertEqual(result["rows"], 2)
+        self.assertEqual(result["duplicate_rows"], [1])
+        self.assertEqual(result["invalid_urls"], ["javascript:alert(1)"])
+        self.assertIn("&lt;script&gt;", result["html"])
+        self.assertNotIn("<script>", result["html"])
+        self.assertNotIn("javascript:", result["html"])
+        self.assertEqual(code, 1)
+
+    def test_unique_rows_keep_numeric_order_and_ignore_fenced_duplicates(self):
+        text = "| [2] | second |\n| [1] | first |\n\n~~~\n| [1] | ignored |\n~~~\n"
+        code, result = run_text(["escape-sources"], text)
+        self.assertEqual(result["rows"], 2)
+        self.assertEqual(result["duplicate_rows"], [])
+        self.assertLess(result["html"].index('id="src-1"'), result["html"].index('id="src-2"'))
+        self.assertNotIn("ignored", result["html"])
+        self.assertEqual(code, 0)
