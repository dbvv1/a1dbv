--- a/tests/test_model.py
+++ b/tests/test_model.py
@@ -117,0 +118,15 @@ def test_structured_exception_identity_survives_pytest_xdist_round_trip():
+
+
+def test_collection_errors_do_not_become_executed_test_outcomes():
+    model = SessionEvidence(collected=1)
+    for phase, nodeid in [("collect", "test_bad.py"), ("collection", "fallback.py")]:
+        _phase(model, nodeid, phase, "failed")
+    assert model.outcomes == {}
+    assert model.executed == 0
+    assert model.errors == set()
+    assert model.collection_errors == {"test_bad.py", "fallback.py"}
+    assert model.error_count == 2
+    assert len(model.phases) == 2
+    _phase(model, "test_good.py::test_ok", "call", "passed")
+    assert model.executed == 1
+    assert model.error_count == 2
