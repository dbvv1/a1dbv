diff --git a/tests/test_collection_counts.py b/tests/test_collection_counts.py
new file mode 100644
index 0000000..6693135
--- /dev/null
+++ b/tests/test_collection_counts.py
@@ -0,0 +1,60 @@
+"""Issue #46: compact counts must preserve actual pytest execution phases."""
+
+import json
+
+import pytest
+
+from pytest_receptor import read_artifact
+
+
+@pytest.mark.parametrize("profile", ["llm", "ci"])
+@pytest.mark.parametrize(
+    "bad_source",
+    ["def test_bad(:\n    pass\n", "import missing_receptor_issue_46_module\n"],
+)
+@pytest.mark.parametrize("partial", [False, True])
+@pytest.mark.parametrize(
+    "stop_args", [[], ["-x"], ["--maxfail=1"], ["--continue-on-collection-errors"]]
+)
+def test_collection_counts_match_native_events(
+    pytester, profile, bad_source, partial, stop_args
+):
+    pytester.makepyfile(test_z_bad=bad_source)
+    if partial:
+        pytester.makepyfile(test_a_good="def test_ok(): pass\n")
+    pytester.makeconftest("""
+import json
+from pathlib import Path
+started = set()
+def pytest_runtest_logstart(nodeid, location):
+    started.add(nodeid)
+def pytest_sessionfinish(session, exitstatus):
+    Path('observed.json').write_text(json.dumps({
+        'started': sorted(started), 'collected': session.testscollected,
+        'exitstatus': int(exitstatus),
+    }))
+""")
+    native = pytester.runpytest_subprocess("--receptor=human", *stop_args)
+    observed_native = json.loads((pytester.path / "observed.json").read_text())
+    result = pytester.runpytest_subprocess(
+        f"--receptor={profile}", "--receptor-events=events.jsonl", *stop_args
+    )
+    observed = json.loads((pytester.path / "observed.json").read_text())
+    assert result.ret == native.ret
+    assert observed == observed_native
+    artifact = read_artifact(pytester.path / "events.jsonl")
+    assert artifact.complete and artifact.integrity_valid
+    counts = artifact.final.data["counts"]
+    assert counts["failed"] == 0
+    assert counts["errors"] == 1
+    assert counts["executed"] == len(observed["started"])
+    assert counts["collected"] == observed["collected"]
+    assert counts["not_executed"] == observed["collected"] - len(observed["started"])
+    assert counts["passed"] == len(observed["started"])
+    assert counts["executed"] <= counts["collected"]
+    assert any(
+        record.type == "phase" and record.data["phase"] == "collect"
+        for record in artifact.events
+    )
+    result.stdout.fnmatch_lines([f"*exit={int(native.ret)} | 1 errors*"])
+    assert "1 failed" not in result.stdout.lines[0]
diff --git a/tests/test_model.py b/tests/test_model.py
