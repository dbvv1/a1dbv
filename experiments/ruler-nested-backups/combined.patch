+      'child/.ruler/AGENTS.md': '# Child rules',
+      'child/.ruler/ruler.toml': '[backup]\nenabled = true\n',
+    });
+
+    try {
+      runRuler(
+        'apply --nested --agents claude,agentsmd --local-only --no-mcp --no-skills --no-subagents',
+        project.projectRoot,
+      );
+      const ignore = await fs.readFile(
+        path.join(project.projectRoot, '.gitignore'),
+        'utf8',
+      );
+      for (const relativePath of [
+        'CLAUDE.md',
+        'AGENTS.md',
+        'child/CLAUDE.md',
+        'child/AGENTS.md',
+      ]) {
+        await expect(
+          fs.access(path.join(project.projectRoot, relativePath)),
+        ).resolves.toBeUndefined();
+        await expect(
+          fs.access(path.join(project.projectRoot, relativePath + '.bak')),
+        ).rejects.toThrow();
+        expect(ignore.split(/\r?\n/)).toContain('/' + relativePath);
+        expect(ignore.split(/\r?\n/)).not.toContain(
+          '/' + relativePath + '.bak',
+        );
+      }
+    } finally {
+      await teardownTestProject(project.projectRoot);
+    }
+  });
