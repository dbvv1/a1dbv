(require :asdf)
(defparameter *root* (uiop:pathname-directory-pathname *load-truename*))
(asdf:load-asd (merge-pathnames "source/image-agent.asd" *root*))
(asdf:load-system "image-agent/store")
(defparameter *store* (merge-pathnames "world/" *root*))
(defparameter *phase* (first (uiop:command-line-arguments)))
(defparameter *world* (image-agent:make-reference-world :package-name "TRIAL-WORLD" :initial '((:runs . 0))))
(defparameter *table* (image-agent:reference-table *world*))
(defparameter *invariants* (list (cons :nonnegative-runs (lambda () (let ((n (gethash :runs *table*))) (and (integerp n) (>= n 0)))))))
(defparameter *session* (if (equal *phase* "create")
                           (image-agent:make-session *world* :store *store* :interactive t :invariants *invariants*)
                           (image-agent:recover-session *world* *store* :interactive t :invariants (unless (equal *phase* "without-checks") *invariants*))))
(defparameter *view* (image-agent:session-step *session*))
(defparameter *checks* 0)
(defun check (label predicate)
  (unless predicate (error "CHECK FAILED: ~a" label))
  (incf *checks*) (format t "~&PASS ~a~%" label))
(defun act (label action &rest fields)
  (setf *view* (image-agent:session-step *session* (append (list :action action :generation (getf *view* :generation)) fields)))
  (format t "~&ACTION ~a~%~s~%" label *view*) *view*)
(defun out () (getf *view* :outcome))
(defun value-text () (getf (first (getf (out) :values)) :text))
(defun revision () (getf *view* :revision))
(defun source-text () (getf (getf (out) :function-info) :source))
(format t "~&PHASE ~a PID ~a SBCL ~a~%" *phase* (sb-posix:getpid) (lisp-implementation-version))
(unwind-protect
  (cond
    ((equal *phase* "create")
     (act "base functions" :develop :source "(progn (defun uppercase-string (text) \"Uppercase without modifying input.\" (string-upcase text)) (defun reverse-string (text) \"Reverse without modifying input.\" (reverse text)))")
     (check "base definitions accepted" (eq (getf (out) :commit) :accepted))
     (act "composition" :develop :source "(defun shout-backwards (text) \"Reverse uppercase text.\" (reverse-string (uppercase-string text)))")
     (check "composition accepted" (eq (getf (out) :commit) :accepted))
     (with-open-file (s (merge-pathnames "v1-revision.sexp" *root*) :direction :output :if-exists :supersede) (write (revision) :stream s))
     (act "v1 hello" :execute :source "(shout-backwards \"Hello\")")
     (check "v1 result" (equal (value-text) "\"OLLEH\""))
     (check "pure call does not create revision" (not (getf (out) :changed)))
     (act "second modification" :develop :source "(defun shout-backwards (text) \"Bracket reverse-uppercase and count uses.\" (incf (gethash :runs *state*)) (concatenate 'string \"[\" (reverse-string (uppercase-string text)) \"]\"))")
     (check "v2 accepted" (eq (getf (out) :commit) :accepted))
     (act "v2 hello" :execute :source "(shout-backwards \"Hello\")")
     (check "v2 result" (equal (value-text) "\"[OLLEH]\""))
     (check "v2 state" (= (gethash :runs *table*) 1))
     (act "describe current v2" :describe :name "shout-backwards")
     (check "source is current" (and (search "INCF" (source-text)) (not (getf (getf (out) :function-info) :source-truncated))))
     (act "discover current functions" :inspect :offset 0)
     (check "three functions discoverable" (= (getf (out) :catalogue-count) 3)))
    ((equal *phase* "reopen")
     (check "saved state recovered" (= (gethash :runs *table*) 1))
     (act "describe after new process" :describe :name "shout-backwards")
     (check "v2 source and docs recovered" (and (search "INCF" (source-text)) (equal (getf (getf (out) :function-info) :documentation) "Bracket reverse-uppercase and count uses.")))
     (act "continued use" :execute :source "(shout-backwards \"World\")")
     (check "reopened result" (equal (value-text) "\"[DLROW]\""))
     (check "continued state" (= (gethash :runs *table*) 2))
     (let ((before (revision)))
       (act "preview" :execute :source "(shout-backwards \"Preview\")" :preview t)
       (check "preview actual result" (equal (value-text) "\"[WEIVERP]\""))
       (check "preview restores state" (= (gethash :runs *table*) 2))
       (check "preview preserves revision" (equal before (revision))))
     (act "unsafe state" :execute :source "(setf (gethash :runs *state*) -1)")
     (check "safety check rejects and restores" (and (eq (getf (out) :reason) :unsafe) (= (gethash :runs *table*) 2)))
     (act "partial mutation then error" :execute :source "(progn (setf (gethash :runs *state*) 99) (error \"intentional failure\"))")
     (check "error pauses actual worker" (eq (getf *view* :status) :paused))
     (act "abort paused attempt" :abort)
     (check "abort restores partial mutation" (and (eq (getf (out) :reason) :aborted) (= (gethash :runs *table*) 2)))
     (act "unknown function description" :describe :name "missing-function")
     (check "missing is not invented" (not (getf (out) :found)))
     (let ((old (with-open-file (s (merge-pathnames "v1-revision.sexp" *root*)) (read s)))
           (count-before (length (image-agent:list-revisions *store*))))
       (act "explicit rollback to v1" :rollback :revision old)
       (check "rollback new revision" (and (eq (getf (out) :commit) :rolled-back) (not (equal old (revision)))))
       (check "rollback preserves history" (= (length (image-agent:list-revisions *store*)) (1+ count-before))))
     (check "rollback restores v1 data" (= (gethash :runs *table*) 0))
     (act "use rolled back composition" :execute :source "(shout-backwards \"Hello\")")
     (check "v1 restored behavior" (equal (value-text) "\"OLLEH\"")))
    ((equal *phase* "reopen-rollback")
     (act "describe recovered rollback" :describe :name "shout-backwards")
     (check "rollback source persisted" (and (search "REVERSE-STRING" (source-text)) (not (search "INCF" (source-text)))))
     (act "call after second reopen" :execute :source "(shout-backwards \"World\")")
     (check "rollback behavior persisted" (equal (value-text) "\"DLROW\""))
     (check "rollback data persisted" (= (gethash :runs *table*) 0)))
    ((equal *phase* "boundaries")
     (let ((before (revision)))
       (act "preview with external file effect" :execute :preview t
            :source (format nil "(progn (incf (gethash :runs *state*)) (with-open-file (s ~s :direction :output :if-exists :supersede :if-does-not-exist :create) (write-line \"synthetic preview side effect\" s)) :done)" (namestring (merge-pathnames "preview-effect.txt" *root*))))
       (check "preview managed table restored" (= (gethash :runs *table*) 0))
       (check "preview file NOT restored" (probe-file (merge-pathnames "preview-effect.txt" *root*)))
       (check "external effect has no new managed revision" (equal before (revision))))
     (setf *view* (image-agent:session-step *session* (list :action :execute :generation -1 :source "(setf (gethash :runs *state*) 42)")))
     (check "stale observation rejected before mutation" (and (eq (getf *view* :rejected) :stale-observation) (= (gethash :runs *table*) 0)))
     (act "long source" :develop :source (format nil "(defun large-description () \"Long-source test.\" (length ~s))" (make-string 5000 :initial-element #\a)))
     (check "large-source function accepted" (eq (getf (out) :commit) :accepted))
     (act "long description boundary" :describe :name "large-description")
     (check "source explicitly truncated" (and (getf (getf (out) :function-info) :source-truncated) (= (length (source-text)) 4096)))
     (act "long function executable" :execute :source "(large-description)")
     (check "long function actually works" (equal (value-text) "5000"))
     (act "empty form" :execute :source "")
     (check "empty form rejected without mutation" (and (eq (getf (out) :commit) :restored) (= (gethash :runs *table*) 0))))
    ((equal *phase* "without-checks")
     (check "recovery did not persist caller safety checks" (null (getf *view* :invariants)))
     (act "negative data without caller invariant" :execute :source "(setf (gethash :runs *state*) -1)")
     (check "previously unsafe data accepted without supplied check" (and (eq (getf (out) :commit) :accepted) (= (gethash :runs *table*) -1)))
     (act "restore valid data by history" :rollback :revision "previous")
     (check "temporary negative data rolled back" (and (eq (getf (out) :commit) :rolled-back) (= (gethash :runs *table*) 0))))
    (t (error "Unknown phase")))
  (image-agent:close-session *session*))
(format t "~&SUCCESS ~a checks=~d~%" *phase* *checks*)
