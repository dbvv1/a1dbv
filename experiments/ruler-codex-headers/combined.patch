+/** Convert Ruler server fields to Codex native configuration fields. */
+function transformMcpForCodex(
+  mcpJson: Record<string, unknown>,
+): Record<string, unknown> {
+  const servers = (mcpJson.mcpServers ?? {}) as Record<
+    string,
+    Record<string, unknown>
+  >;
+  return {
+    ...mcpJson,
+    mcpServers: Object.fromEntries(
+      Object.entries(servers).map(([name, server]) => {
+        const copy = { ...server };
+        // Codex infers the transport from command/url and consumes http_headers.
+        delete copy.type;
+        if (copy.url && copy.headers) {
+          copy.http_headers = copy.headers;
+          delete copy.headers;
+        }
+        return [name, copy];
+      }),
+    ),
+  };
+}
