diff --git a/test/solidlsp/vue/test_vue_implementation.py b/test/solidlsp/vue/test_vue_implementation.py
new file mode 100644
index 0000000..4a0e5db
--- /dev/null
+++ b/test/solidlsp/vue/test_vue_implementation.py
@@ -0,0 +1,20 @@
+# SPDX-License-Identifier: MIT
+import os
+
+import pytest
+
+from solidlsp import SolidLanguageServer
+from solidlsp.ls_config import LanguageServerId
+
+
+@pytest.mark.vue
+@pytest.mark.parametrize("language_server", [LanguageServerId.VUE], indirect=True)
+def test_typescript_interface_implementation(language_server: SolidLanguageServer) -> None:
+    file_path = os.path.join("src", "shapes.ts")
+    locations = language_server.request_implementation(file_path, 1, 17)
+
+    assert language_server.supports_implementation_request()
+    assert len(locations) == 1
+    assert locations[0]["relativePath"] == file_path
+    assert locations[0]["range"]["start"] == {"line": 5, "character": 13}
+    assert locations[0]["range"]["end"] == {"line": 5, "character": 19}
