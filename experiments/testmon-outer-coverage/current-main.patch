@@ -0,0 +1,120 @@
+import os
+import subprocess
+import sys
+
+import coverage
+import pytest
+
+from testmon import configure
+
+
+def test_detects_active_coverage(tmp_path):
+    cov = coverage.Coverage(data_file=str(tmp_path / ".coverage"))
+    cov.start()
+    try:
+        assert configure._is_coverage()
+    finally:
+        cov.stop()
+
+
+def test_no_active_coverage(tmp_path):
+    result = run_python(
+        tmp_path,
+        "-c",
+        "from testmon import configure; assert not configure._is_coverage()",
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+@pytest.fixture
+def sample(tmp_path):
+    (tmp_path / "pytest.ini").write_text("[pytest]\n")
+    (tmp_path / "mod.py").write_text(
+        "def classify(x):\n"
+        "    if x > 0:\n"
+        '        return "positive"\n'
+        "    if x < 0:\n"
+        '        return "negative"\n'
+        '    return "zero"\n'
+    )
+    (tmp_path / "test_mod.py").write_text(
+        "from mod import classify\n"
+        "def test_positive():\n"
+        '    assert classify(1) == "positive"\n'
+        "def test_negative():\n"
+        '    assert classify(-1) == "negative"\n'
+        "def test_zero():\n"
+        '    assert classify(0) == "zero"\n'
+    )
+    return tmp_path
+
+
+def run_python(sample, *args):
+    return subprocess.run(
+        [sys.executable, *args],
+        cwd=sample,
+        capture_output=True,
+        text=True,
+        env={**os.environ, "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
+        timeout=60,
+    )
+
+
+@pytest.mark.parametrize("with_testmon", [False, True])
+@pytest.mark.parametrize("failing", [False, True])
+def test_outer_coverage_keeps_test_execution(sample, with_testmon, failing):
+    if failing:
+        test_file = sample / "test_mod.py"
+        test_file.write_text(test_file.read_text().replace('== "zero"', '== "wrong"'))
+    command = [
+        "-m",
+        "coverage",
+        "run",
+        "--branch",
+        "-m",
+        "pytest",
+        "-p",
+        "testmon.pytest_testmon",
+        "test_mod.py",
+    ]
+    if with_testmon:
+        command.append("--testmon")
+    result = run_python(sample, *command)
+    assert result.returncode == (1 if failing else 0), result.stdout + result.stderr
+    assert ("1 failed, 2 passed" if failing else "3 passed") in result.stdout
+    cov = coverage.Coverage(data_file=str(sample / ".coverage"))
+    cov.load()
+    percent = cov.report(include=[str(sample / "mod.py")])
+    assert cov.analysis2(str(sample / "mod.py"))[3] == []
+    assert percent == 100
+    if with_testmon:
+        assert "coverage.py was detected" in result.stdout
+
+
+def test_plain_testmon_still_collects_and_selects(sample):
+    command = ["-m", "pytest", "-p", "testmon.pytest_testmon", "--testmon"]
+    first = run_python(sample, *command)
+    assert first.returncode == 0, first.stdout + first.stderr
+    assert "3 passed" in first.stdout
+    second = run_python(sample, *command)
+    assert second.returncode == 0, second.stdout + second.stderr
+    assert "no tests ran" in second.stdout
+
+
+def test_pytest_cov_still_collects(sample):
+    pytest.importorskip("pytest_cov")
+    result = run_python(
+        sample,
+        "-m",
+        "pytest",
+        "-p",
+        "testmon.pytest_testmon",
+        "-p",
+        "pytest_cov.plugin",
+        "--cov=mod",
+        "--testmon",
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "3 passed" in result.stdout
+    assert "100%" in result.stdout
+    assert "coverage.py was detected" not in result.stdout
