+import {test,expect} from '@playwright/test';
+import {readFileSync,writeFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {prisma} from '@documenso/prisma';
+const ROOT=process.env.P25_ARTIFACT_DIR!;
+const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
+test('Post-run independently compare download to sealed stored bytes',async({request})=>{
+ const ctx=JSON.parse(readFileSync(`${ROOT}/private-context.json`,'utf8'));
+ const {envelope}=JSON.parse(readFileSync(`${ROOT}/private-envelope.json`,'utf8'));
+ const e=await prisma.envelope.findUniqueOrThrow({where:{id:envelope.id}});
+ expect(e.completedAt!==null).toBe(true);expect(e.status).toBe('COMPLETED');
+ const item=await prisma.envelopeItem.findFirstOrThrow({where:{envelopeId:e.id},include:{documentData:true}});
+ expect(['BYTES','BYTES_64']).toContain(item.documentData.type);
+ const stored=Buffer.from(item.documentData.data,item.documentData.type==='BYTES_64'?'base64':'utf8');
+ const res=await request.get(`http://127.0.0.1:3250/api/v2-beta/envelope/item/${item.id}/download?version=signed`,{headers:{Authorization:`Bearer ${ctx.token}`}});
+ expect(res.status()).toBe(200);const bytes=await res.body();
+ expect(bytes.subarray(0,5).toString()).toBe('%PDF-');expect(hash(bytes)).toBe(hash(stored));expect(hash(bytes)).toBe(hash(readFileSync(`${ROOT}/synthetic-final.pdf`)));
+ writeFileSync(`${ROOT}/public-supplement/download-followup.json`,JSON.stringify({kind:'Post-run additional assertions, not original main-track assertions',completedAtNonNull:e.completedAt!==null,status:e.status,httpStatus:res.status(),pdfMagic:true,downloadHash:hash(bytes),storedPdfHash:hash(stored),frozenArtifactHash:hash(readFileSync(`${ROOT}/synthetic-final.pdf`)),bytes:bytes.length},null,2)+'\n');
+});
