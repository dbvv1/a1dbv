+const server=new SMTPServer({authOptional:true,disabledCommands:['AUTH','STARTTLS'],onData(stream,session,callback){const chunks=[];stream.on('data',c=>chunks.push(c));stream.on('end',()=>{count++;fs.writeFileSync(`reverse-mail-capture/message-${count}.eml`,Buffer.concat(chunks),{mode:0o600});fs.appendFileSync('reverse-mail-capture/index.jsonl',JSON.stringify({index:count,to:session.envelope.rcptTo.map(x=>x.address),bytes:Buffer.concat(chunks).length})+'\n');callback();});}});
+server.listen(25250,'127.0.0.1',()=>console.log('Synthetic SMTP sink bound loopback 25250; never relays.'));
