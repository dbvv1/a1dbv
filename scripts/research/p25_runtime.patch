+++ b/packages/app-tests/p25-smtp.cjs
@@ -0,0 +1,5 @@
+const {SMTPServer}=require(process.env.P25_ARTIFACT_DIR + '/node_modules/smtp-server');
+const fs=require('node:fs');
+let count=fs.existsSync('mail-capture/index.jsonl')?fs.readFileSync('mail-capture/index.jsonl','utf8').trim().split('\n').filter(Boolean).length:0;
+const server=new SMTPServer({authOptional:true,disabledCommands:['AUTH','STARTTLS'],onData(stream,session,callback){const chunks=[];stream.on('data',c=>chunks.push(c));stream.on('end',()=>{count++;fs.writeFileSync(`mail-capture/message-${count}.eml`,Buffer.concat(chunks),{mode:0o600});fs.appendFileSync('mail-capture/index.jsonl',JSON.stringify({index:count,to:session.envelope.rcptTo.map(x=>x.address),bytes:Buffer.concat(chunks).length})+'\n');callback();});}});
+server.listen(25250,'127.0.0.1',()=>console.log('Synthetic SMTP sink bound loopback 25250; never relays.'));
