 }
+
+/* Users opt-in only: portal content roots carry both classes explicitly. */
+.users-theme {
+  --primary: oklch(0.488 0.243 264.376);
+  --primary-foreground: oklch(0.985 0 0);
+  --ring: oklch(0.546 0.245 262.881);
+  --accent: oklch(0.932 0.032 255.585);
+  --accent-foreground: oklch(0.379 0.146 265.522);
+}
+
+.dark .users-theme {
+  --primary: oklch(0.707 0.165 254.624);
+  --primary-foreground: oklch(0.129 0.042 264.695);
+  --ring: oklch(0.707 0.165 254.624);
+  --accent: oklch(0.282 0.091 267.935);
+  --accent-foreground: oklch(0.932 0.032 255.585);
+}
+
+/* The html attribute supplies values, never global element styles. */
+html[data-users-density='comfortable'] {
+  --users-control-height: 36px;
+  --users-cell-padding: 8px;
+  --users-form-gap: 16px;
+  --users-dialog-padding: 24px;
+}
+
+html[data-users-density='compact'] {
+  --users-control-height: 32px;
+  --users-cell-padding: 4px;
+  --users-form-gap: 12px;
+  --users-dialog-padding: 16px;
+}
+
+/* Unlayered scoped consumers override existing h-8/size utilities vertically.
+   Do not resize checkboxes or horizontal cells: sticky offsets stay intact. */
+.users-density
+  :is(
+    [data-slot='button'],
+    input:not([type='checkbox']):not([type='hidden']),
+    [data-slot='select-trigger'],
+    [data-slot='command-input-wrapper']
+  ) {
+  height: var(--users-control-height, 36px);
+}
+
+.users-density
+  :is(
+    [data-slot='select-item'],
+    [data-slot='dropdown-menu-item'],
+    [data-slot='dropdown-menu-checkbox-item'],
+    [data-slot='command-item']
+  ) {
+  min-height: var(--users-control-height, 36px);
+  padding-block: var(--users-cell-padding, 8px);
+}
+
+.users-density [data-slot='table-cell'] {
+  padding-block: var(--users-cell-padding, 8px);
+}
+
+.users-density[data-slot='dialog-content'] {
+  padding: var(--users-dialog-padding, 24px);
+  gap: var(--users-form-gap, 16px);
+}
+
+.users-density .users-edit-form > * {
+  margin-block: 0;
+}
+
+.users-density .users-edit-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--users-form-gap, 16px);
+}
+
+.users-density [data-slot='command-input'] {
+  height: 100%;
+  padding-block: 0;
+}
