+import { useRef } from 'react'
+import { useForm, useWatch } from 'react-hook-form'
+import { zodResolver } from '@hookform/resolvers/zod'
+import { Button } from '@/components/ui/button'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import {
+  Form,
+  FormField,
+  FormItem,
+  FormLabel,
+  FormMessage,
+} from '@/components/ui/form'
+import { SelectDropdown } from '@/components/select-dropdown'
+import {
+  bulkEditDraftSchema,
+  draftToPatch,
+  emptyBulkEditDraft,
+  NO_CHANGE,
+  type BulkEditDraft,
+  type BulkEditPatch,
+} from '../data/bulk-edit'
+import { roles } from '../data/data'
+import { userStatusSchema } from '../data/schema'
+
+type UsersBulkEditDialogProps = {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+  selectedIds: string[]
+  onConfirm: (ids: string[], patch: BulkEditPatch) => void
+  onCloseFocus: () => void
+}
+
+export function UsersBulkEditDialog({
+  open,
+  onOpenChange,
+  selectedIds,
+  onConfirm,
+  onCloseFocus,
+}: UsersBulkEditDialogProps) {
+  const submitting = useRef(false)
+  const form = useForm<BulkEditDraft>({
+    resolver: zodResolver(bulkEditDraftSchema),
+    defaultValues: emptyBulkEditDraft(),
+  })
+  const values = useWatch({ control: form.control })
+  const hasChange = values.role !== NO_CHANGE || values.status !== NO_CHANGE
+
+  const changeOpen = (next: boolean) => {
+    form.reset(emptyBulkEditDraft())
+    submitting.current = false
+    onOpenChange(next)
+  }
+
+  const onSubmit = (draft: BulkEditDraft) => {
+    if (submitting.current || selectedIds.length === 0) return
+    submitting.current = true
+    try {
+      const patch = draftToPatch(draft)
+      onConfirm([...selectedIds], patch)
+      changeOpen(false)
+    } catch {
+      form.setError('root', {
+        message: 'No changes applied. Choose a valid field and try again.',
+      })
+      submitting.current = false
+    }
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={changeOpen}>
+      <DialogContent
+        className='users-theme users-density sm:max-w-lg'
+        onCloseAutoFocus={(event) => {
+          event.preventDefault()
+          onCloseFocus()
+        }}
+      >
+        <DialogHeader className='text-start'>
+          <DialogTitle>Edit {selectedIds.length} selected users</DialogTitle>
+          <DialogDescription>
+            Only users selected under the current filters when this dialog
+            opened will change. Local demo only; refresh resets the data.
+          </DialogDescription>
+        </DialogHeader>
+        <Form {...form}>
+          <form
+            id='users-bulk-edit-form'
+            onSubmit={(event) => void form.handleSubmit(onSubmit)(event)}
+            className='users-edit-form'
+          >
+            <FormField
+              control={form.control}
+              name='role'
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Role</FormLabel>
+                  <SelectDropdown
+                    isControlled
+                    defaultValue={field.value}
+                    onValueChange={field.onChange}
+                    contentClassName='users-theme users-density'
+                    items={[
+                      { label: 'Do not change', value: NO_CHANGE },
+                      ...roles,
+                    ]}
+                  />
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+            <FormField
+              control={form.control}
+              name='status'
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Status</FormLabel>
+                  <SelectDropdown
+                    isControlled
+                    defaultValue={field.value}
+                    onValueChange={field.onChange}
+                    contentClassName='users-theme users-density'
+                    items={[
+                      { label: 'Do not change', value: NO_CHANGE },
+                      ...userStatusSchema.options.map((status) => ({
+                        label: status.value,
+                        value: status.value,
+                      })),
+                    ]}
+                  />
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+            {form.formState.errors.root && (
+              <p role='alert' className='text-sm text-destructive'>
+                {form.formState.errors.root.message}
+              </p>
+            )}
+          </form>
+        </Form>
+        <DialogFooter>
+          <Button
+            type='button'
+            variant='outline'
+            onClick={() => changeOpen(false)}
+          >
+            Cancel
+          </Button>
+          <Button
+            type='submit'
+            form='users-bulk-edit-form'
+            disabled={
+              !hasChange ||
+              selectedIds.length === 0 ||
+              form.formState.isSubmitting
+            }
+          >
+            Apply locally
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
