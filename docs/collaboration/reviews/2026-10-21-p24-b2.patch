new file mode 100644
index 0000000..91933fb
--- /dev/null
+++ b/src/features/users/data/bulk-edit.ts
@@ -0,0 +1,66 @@
+import { z } from 'zod'
+import { userRoleSchema, userStatusSchema, type User } from './schema.ts'
+
+export const NO_CHANGE = 'no-change' as const
+export const bulkEditDraftSchema = z.object({
+  role: z.union([z.literal(NO_CHANGE), userRoleSchema]),
+  status: z.union([z.literal(NO_CHANGE), userStatusSchema]),
+})
+export type BulkEditDraft = z.infer<typeof bulkEditDraftSchema>
+
+export const bulkEditPatchSchema = z
+  .object({
+    role: userRoleSchema.optional(),
+    status: userStatusSchema.optional(),
+  })
+  .strict()
+  .refine((patch) => patch.role !== undefined || patch.status !== undefined, {
+    message: 'Choose at least one field to change.',
+  })
+export type BulkEditPatch = z.infer<typeof bulkEditPatchSchema>
+
+export function emptyBulkEditDraft(): BulkEditDraft {
+  return { role: NO_CHANGE, status: NO_CHANGE }
+}
+
+export function draftToPatch(draft: BulkEditDraft): BulkEditPatch {
+  const parsed = bulkEditDraftSchema.parse(draft)
+  return bulkEditPatchSchema.parse({
+    ...(parsed.role === NO_CHANGE ? {} : { role: parsed.role }),
+    ...(parsed.status === NO_CHANGE ? {} : { status: parsed.status }),
+  })
+}
+
+export type BulkEditSession = { open: boolean; selectedIds: string[] }
+
+// Snapshot the filtered selection, not just the current page or hidden rows.
+export function beginBulkEdit(
+  rows: readonly { original: Pick<User, 'id'> }[]
+): BulkEditSession {
+  return {
+    open: true,
+    selectedIds: [...new Set(rows.map((row) => row.original.id))],
+  }
+}
+
+// Closing discards only the dialog session. Data and selection are untouched.
+export function closeBulkEdit(): BulkEditSession {
+  return { open: false, selectedIds: [] }
+}
+
+export function applyBulkEdit(
+  users: User[],
+  ids: readonly string[],
+  patch: BulkEditPatch
+): User[] {
+  const parsed = bulkEditPatchSchema.parse(patch)
+  // Omitted fields, including explicit undefined, must preserve existing data.
+  const changes = {
+    ...(parsed.role === undefined ? {} : { role: parsed.role }),
+    ...(parsed.status === undefined ? {} : { status: parsed.status }),
+  }
+  const targets = new Set(ids)
+  return users.map((user) =>
+    targets.has(user.id) ? { ...user, ...changes } : user
+  )
+}
