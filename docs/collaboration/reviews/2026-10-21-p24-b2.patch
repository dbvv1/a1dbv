+// Browser-mode regression source. Execution is pending a permitted browser.
+// Keep the dialog component mounted while open changes to exercise real reset.
+import { useRef, useState } from 'react'
+import { describe, expect, it, vi } from 'vitest'
+import { render } from 'vitest-browser-react'
+import { userEvent } from 'vitest/browser'
+import { type BulkEditPatch } from '../data/bulk-edit'
+import { UsersBulkEditDialog } from './users-bulk-edit-dialog'
+
+function Harness({
+  onConfirm,
+}: {
+  onConfirm: (ids: string[], patch: BulkEditPatch) => void
+}) {
+  const [open, setOpen] = useState(true)
+  const reopen = useRef<HTMLButtonElement>(null)
+  return (
+    <>
+      <button ref={reopen} type='button' onClick={() => setOpen(true)}>
+        Reopen
+      </button>
+      <UsersBulkEditDialog
+        open={open}
+        onOpenChange={setOpen}
+        selectedIds={['U1']}
+        onConfirm={onConfirm}
+        onCloseFocus={() => reopen.current?.focus()}
+      />
+    </>
+  )
+}
+
+describe('UsersBulkEditDialog continuously mounted', () => {
+  it('disables empty submit and resets both controlled selects after cancel/reopen', async () => {
+    const confirm = vi.fn()
+    const screen = await render(<Harness onConfirm={confirm} />)
+    const apply = screen.getByRole('button', { name: 'Apply locally' })
+    await expect.element(apply).toBeDisabled()
+    await userEvent.click(screen.getByRole('combobox', { name: 'Role' }))
+    await userEvent.click(
+      screen.getByRole('option', { name: 'Manager', exact: true })
+    )
+    await userEvent.click(screen.getByRole('combobox', { name: 'Status' }))
+    await userEvent.click(
+      screen.getByRole('option', { name: 'active', exact: true })
+    )
+    await expect.element(apply).toBeEnabled()
+    await userEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    expect(confirm).not.toHaveBeenCalled()
+    await expect
+      .element(screen.getByRole('button', { name: 'Reopen' }))
+      .toHaveFocus()
+    await userEvent.click(screen.getByRole('button', { name: 'Reopen' }))
+    await expect
+      .element(screen.getByRole('combobox', { name: 'Role' }))
+      .toHaveTextContent('Do not change')
+    await expect
+      .element(screen.getByRole('combobox', { name: 'Status' }))
+      .toHaveTextContent('Do not change')
+    await expect.element(apply).toBeDisabled()
+  })
+
+  it('submits snapshot IDs and only the changed field once', async () => {
+    const confirm = vi.fn()
+    const screen = await render(<Harness onConfirm={confirm} />)
+    await userEvent.click(screen.getByRole('combobox', { name: 'Status' }))
+    await userEvent.click(
+      screen.getByRole('option', { name: 'active', exact: true })
+    )
+    await userEvent.click(screen.getByRole('button', { name: 'Apply locally' }))
+    await vi.waitFor(() =>
+      expect(confirm).toHaveBeenCalledExactlyOnceWith(['U1'], {
+        status: 'active',
+      })
+    )
+    await userEvent.click(screen.getByRole('button', { name: 'Reopen' }))
+    await expect
+      .element(screen.getByRole('button', { name: 'Apply locally' }))
+      .toBeDisabled()
+  })
+
+  it('Escape and close discard without submitting; same instance reopens empty', async () => {
+    const confirm = vi.fn()
+    const screen = await render(<Harness onConfirm={confirm} />)
+    for (const close of ['escape', 'button']) {
+      await userEvent.click(screen.getByRole('combobox', { name: 'Role' }))
+      await userEvent.click(
+        screen.getByRole('option', { name: 'Admin', exact: true })
+      )
+      if (close === 'escape') await userEvent.keyboard('{Escape}')
+      else
+        await userEvent.click(
+          screen.getByRole('button', { name: 'Close', exact: true })
+        )
+      expect(confirm).not.toHaveBeenCalled()
+      await userEvent.click(screen.getByRole('button', { name: 'Reopen' }))
+      await expect
+        .element(screen.getByRole('combobox', { name: 'Role' }))
+        .toHaveTextContent('Do not change')
+      await expect
+        .element(screen.getByRole('button', { name: 'Apply locally' }))
