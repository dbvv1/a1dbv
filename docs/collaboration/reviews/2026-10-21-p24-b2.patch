@@ -0,0 +1,96 @@
+// Pure state checks, not browser, React mounting, focus, ARIA or visual tests.
+// Run: node --test tests/p24-bulk-edit.node-check.mjs (Node 24 strips TS).
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { createTable, getCoreRowModel, getFilteredRowModel, getPaginationRowModel } from '@tanstack/react-table'
+import { applyBulkEdit, beginBulkEdit, bulkEditPatchSchema, closeBulkEdit, draftToPatch, emptyBulkEditDraft, NO_CHANGE } from '../src/features/users/data/bulk-edit.ts'
+
+const users = Object.freeze([
+  { id: 'U1', firstName: 'One', lastName: 'Example', username: 'one', email: 'one@example.test', phoneNumber: '+12025550101', status: 'inactive', role: 'cashier', createdAt: new Date('2026-01-01'), updatedAt: new Date('2026-01-01') },
+  { id: 'U2', firstName: 'Two', lastName: 'Example', username: 'two', email: 'two@example.test', phoneNumber: '+12025550102', status: 'inactive', role: 'manager', createdAt: new Date('2026-01-01'), updatedAt: new Date('2026-01-01') },
+  { id: 'U3', firstName: 'Three', lastName: 'Example', username: 'three', email: 'three@example.test', phoneNumber: '+12025550103', status: 'active', role: 'admin', createdAt: new Date('2026-01-01'), updatedAt: new Date('2026-01-01') },
+].map(Object.freeze))
+
+function makeTable(selection, filters = []) {
+  return createTable({
+    data: users,
+    columns: [{ accessorKey: 'id' }, { accessorKey: 'status', filterFn: (row, id, value) => value.includes(row.getValue(id)) }],
+    state: { rowSelection: selection, columnFilters: filters, pagination: { pageIndex: 0, pageSize: 1 } },
+    getRowId: (user) => user.id,
+    getCoreRowModel: getCoreRowModel(),
+    getFilteredRowModel: getFilteredRowModel(),
+    getPaginationRowModel: getPaginationRowModel(),
+    onStateChange: () => {},
+    renderFallbackValue: null,
+  })
+}
+
+test('U1/U3 selection then inactive filter snapshots only U1, across stable IDs', () => {
+  const table = makeTable({ U1: true, U3: true }, [{ id: 'status', value: ['inactive'] }])
+  assert.deepEqual(beginBulkEdit(table.getFilteredSelectedRowModel().rows), { open: true, selectedIds: ['U1'] })
+  assert.deepEqual(Object.keys(table.getState().rowSelection), ['U1', 'U3'])
+  assert.equal(table.getCoreRowModel().rowsById.U1.original.id, 'U1')
+})
+
+test('snapshot spans selected pages but excludes hidden selections and stays fixed after filters change', () => {
+  const table = makeTable({ U1: true, U2: true, U3: true }, [{ id: 'status', value: ['inactive'] }])
+  assert.equal(table.getRowModel().rows.length, 1)
+  const session = beginBulkEdit(table.getFilteredSelectedRowModel().rows)
+  assert.deepEqual(session.selectedIds, ['U1', 'U2'])
+  table.setOptions((previous) => ({ ...previous, state: { ...previous.state, columnFilters: [{ id: 'status', value: ['active'] }] } }))
+  assert.deepEqual(beginBulkEdit(table.getFilteredSelectedRowModel().rows).selectedIds, ['U3'])
+  assert.deepEqual(session.selectedIds, ['U1', 'U2'])
+})
+
+test('status patch changes only snapshot IDs and preserves all other fields', () => {
+  const changed = applyBulkEdit(users, ['U1'], draftToPatch({ role: NO_CHANGE, status: 'active' }))
+  assert.deepEqual(changed[0], { ...users[0], status: 'active' })
+  assert.equal(changed[0].createdAt, users[0].createdAt)
+  assert.equal(changed[0].updatedAt, users[0].updatedAt)
+  assert.equal(changed[1], users[1])
+  assert.equal(changed[2], users[2])
+  assert.equal(users[0].status, 'inactive')
+  const table = makeTable({ U1: true, U3: true }, [{ id: 'status', value: ['inactive'] }])
+  table.setOptions((previous) => ({ ...previous, data: changed }))
+  assert.deepEqual(table.getFilteredRowModel().rows.map((row) => row.id), ['U2'])
+  assert.equal(table.getCoreRowModel().rowsById.U1.original.status, 'active')
+})
+
+test('role-only and both-field patches, duplicate and missing IDs stay bounded', () => {
+  const roleOnly = applyBulkEdit(users, ['U1', 'U1', 'missing'], { role: 'admin', status: undefined })
+  assert.deepEqual(roleOnly[0], { ...users[0], role: 'admin' })
+  assert.equal(roleOnly[1], users[1])
+  const both = applyBulkEdit(users, ['U2'], { role: 'cashier', status: 'suspended' })
+  assert.deepEqual(both[1], { ...users[1], role: 'cashier', status: 'suspended' })
+  assert.deepEqual(applyBulkEdit(users, [], { status: 'active' }), users)
+})
+
+test('empty, placeholder, malformed and unknown-field patches cannot write', () => {
+  for (const patch of [{}, { role: undefined }, { role: '' }, { status: '' }, { status: NO_CHANGE }, { role: 'owner' }, { status: 'active', email: 'overwritten@example.test' }, { status: null }]) {
+    assert.equal(bulkEditPatchSchema.safeParse(patch).success, false)
+    assert.throws(() => applyBulkEdit(users, ['U1'], patch))
+  }
+  assert.throws(() => draftToPatch(emptyBulkEditDraft()))
+  assert.throws(() => draftToPatch({ role: '', status: 'active' }))
+  assert.deepEqual(draftToPatch({ role: 'manager', status: NO_CHANGE }), { role: 'manager' })
+})
+
+test('pure cancel/reset discards session and draft without touching data or selection', () => {
+  const selection = Object.freeze({ U1: true, U3: true })
+  const table = makeTable(selection, [{ id: 'status', value: ['inactive'] }])
+  const opened = beginBulkEdit(table.getFilteredSelectedRowModel().rows)
+  let session = opened
+  let draft = { role: 'admin', status: 'active' }
+  const before = structuredClone(users)
+  // Same pure close/reset helpers called by the UI cancellation handlers.
+  session = closeBulkEdit()
+  draft = emptyBulkEditDraft()
+  assert.deepEqual(session, { open: false, selectedIds: [] })
+  assert.deepEqual(draft, { role: NO_CHANGE, status: NO_CHANGE })
+  assert.deepEqual(users, before)
+  assert.equal(table.getState().rowSelection, selection)
+  assert.deepEqual(selection, { U1: true, U3: true })
+  assert.deepEqual(opened.selectedIds, ['U1'])
+  assert.deepEqual(beginBulkEdit(table.getFilteredSelectedRowModel().rows), opened)
+  assert.notEqual(emptyBulkEditDraft(), draft)
+})
