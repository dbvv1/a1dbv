diff --git a/tests/unit/agents/CodexCliAgent.project-doc-limit.test.ts b/tests/unit/agents/CodexCliAgent.project-doc-limit.test.ts
new file mode 100644
index 0000000..e3de539
--- /dev/null
+++ b/tests/unit/agents/CodexCliAgent.project-doc-limit.test.ts
@@ -0,0 +1,116 @@
+import * as fs from 'fs/promises';
+import * as path from 'path';
+import os from 'os';
+
+import { CodexCliAgent } from '../../../src/agents/CodexCliAgent';
+import { AgentsMdAgent } from '../../../src/agents/AgentsMdAgent';
+import { CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES } from '../../../src/constants';
+
+const MARKER = '<!-- Generated by Ruler -->\n';
+const MARKER_BYTES = Buffer.byteLength(MARKER);
+
+function rulesOfExactSize(bytes: number): string {
+  return 'a'.repeat(bytes - MARKER_BYTES);
+}
+
+describe('CodexCliAgent project_doc_max_bytes warning', () => {
+  let tmpDir: string;
+  let warnSpy: jest.SpyInstance;
+
+  beforeEach(async () => {
+    tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), 'ruler-codex-limit-'));
+    warnSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(async () => {
+    warnSpy.mockRestore();
+    await fs.rm(tmpDir, { recursive: true, force: true });
+  });
+
+  it('warns once when generated AGENTS.md exceeds the 32 KiB default', async () => {
+    const agent = new CodexCliAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES + 1);
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).toHaveBeenCalledTimes(1);
+    const message = String(warnSpy.mock.calls[0][0]);
+    expect(message).toContain('project_doc_max_bytes');
+    expect(message).toContain(String(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES));
+    expect(message).toContain('32 KiB');
+    expect(message).toContain('AGENTS.md');
+  });
+
+  it('does not warn when the generated AGENTS.md is exactly at the limit', async () => {
+    const agent = new CodexCliAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES);
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).not.toHaveBeenCalled();
+  });
+
+  it('does not warn when the generated AGENTS.md is below the limit', async () => {
+    const agent = new CodexCliAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES - 1);
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).not.toHaveBeenCalled();
+  });
+
+  it('measures UTF-8 bytes, not characters', async () => {
+    const agent = new CodexCliAgent();
+    // 11,000 characters but 33,000 UTF-8 bytes.
+    const rules = '规'.repeat(11_000);
+    expect(rules.length).toBeLessThan(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES);
+    expect(Buffer.byteLength(rules)).toBeGreaterThan(
+      CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES,
+    );
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).toHaveBeenCalledTimes(1);
+    expect(String(warnSpy.mock.calls[0][0])).toContain(
+      `${Buffer.byteLength(rules) + MARKER_BYTES} bytes`,
+    );
+  });
+
+  it('leaves the generated content and Codex config untouched', async () => {
+    const agent = new CodexCliAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES + 500);
+    const configPath = path.join(tmpDir, '.codex', 'config.toml');
+    await fs.mkdir(path.dirname(configPath), { recursive: true });
+    await fs.writeFile(configPath, 'project_doc_max_bytes = 65536\n');
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    const written = await fs.readFile(path.join(tmpDir, 'AGENTS.md'), 'utf8');
+    expect(Buffer.byteLength(written)).toBe(
+      CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES + 500,
+    );
+    expect(written.endsWith(rules)).toBe(true);
+    expect(await fs.readFile(configPath, 'utf8')).toBe(
+      'project_doc_max_bytes = 65536\n',
+    );
+  });
+
+  it('warns again on the next generation', async () => {
+    const agent = new CodexCliAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES + 1);
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).toHaveBeenCalledTimes(2);
+  });
+
+  it('does not warn for another agent that writes AGENTS.md', async () => {
+    const agent = new AgentsMdAgent();
+    const rules = rulesOfExactSize(CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES + 1);
+
+    await agent.applyRulerConfig(rules, tmpDir, null);
+
+    expect(warnSpy).not.toHaveBeenCalled();
+  });
+});
