+// Codex CLI reads at most this many bytes of project instructions by default
+// (the `project_doc_max_bytes` setting); content past the limit is silently
+// dropped. This is a documented consumer default, not a Ruler generation limit.
+export const CODEX_DEFAULT_PROJECT_DOC_MAX_BYTES = 32 * 1024;
