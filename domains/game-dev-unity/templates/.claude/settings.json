{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(dotnet build*)",
      "Bash(.claude/skills/unity-compile-check/scripts/compile_check.sh*)",
      "Bash(.claude/skills/unity-run-tests/scripts/run_tests.sh*)",
      "Bash(unity status*)",
      "Bash(unity recompile*)",
      "Bash(unity test *)",
      "Bash(unity logs*)",
      "Bash(unity commands --grep*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Edit(ProjectSettings/**)",
      "Edit(Packages/manifest.json)",
      "Write(ProjectSettings/**)",
      "Write(Packages/manifest.json)"
    ],
    "deny": [
      "Read(Library/**)",
      "Read(Temp/**)",
      "Read(obj/**)",
      "Edit(Library/**)",
      "Edit(Temp/**)",
      "Edit(obj/**)",
      "Write(Library/**)",
      "Write(Temp/**)",
      "Write(obj/**)",
      "Read(.env*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ]
  }
}
