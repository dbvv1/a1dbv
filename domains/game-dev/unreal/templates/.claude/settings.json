{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(.claude/skills/ue-build/scripts/build.sh*)",
      "Bash(.claude/skills/ue-run-tests/scripts/run_tests.sh*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(p4 submit*)",
      "Edit(Config/**)",
      "Write(Config/**)",
      "Edit(*.uproject)",
      "Write(*.uproject)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(build/**)",
      "Read(Binaries/**)",
      "Read(Intermediate/**)",
      "Read(DerivedDataCache/**)",
      "Read(Saved/Cooked/**)",
      "Read(Saved/StagedBuilds/**)",
      "Read(Saved/Autosaves/**)",
      "Edit(Binaries/**)",
      "Edit(Intermediate/**)",
      "Write(Binaries/**)",
      "Write(Intermediate/**)",
      "Read(.env*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ]
  }
}
