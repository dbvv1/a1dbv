# 统一使用 LF 换行，由 Git 自动识别文本文件
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Unified patch context markers are data; added source whitespace is checked on apply.
experiments/openspec-mdx.patch whitespace=-blank-at-eol
experiments/memos-reading-adoption.patch whitespace=-blank-at-eol
experiments/opensrc-ref-integrity/source-ref-integrity.patch whitespace=-blank-at-eol
experiments/serena-vue-implementation/fix.patch whitespace=-blank-at-eol
